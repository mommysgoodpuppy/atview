from "./ansi.wm" import * as Ansi;
from "./geometry.wm" import * as Geometry;
from "./image.wm" import { Image, Scale, Fit, Fill };
from "./png.wm" import * as Png;
from "./theme.wm" import * as Theme;
from "./sixel.wm" import { Target };
from js.global("Math") import { floor };

let down = (value) => {
  floor(value) :> Result.getOr(0)
};

let blend = (value, alpha, background) => {
  down((value * alpha + background * (255 - alpha)) / 255)
};

let pixel = (pixels, x, y) => {
  let safeX = Geometry.clamp(0, pixels.width - 1, down(x));
  let safeY = Geometry.clamp(0, pixels.height - 1, down(y));
  let (red, green, blue, alpha) = Png.rgba(pixels, safeX, safeY);
  (
    blend(red, alpha, Theme.libadwaitaDark.red),
    blend(green, alpha, Theme.libadwaitaDark.green),
    blend(blue, alpha, Theme.libadwaitaDark.blue),
  )
};

let mappingSize = (area: Geometry.Rect, mode: Scale, pixelWidth, pixelHeight) => {
  match(mode) {
  Fit => {
    let scale = if (area.width / pixelWidth < (area.height * 2) / pixelHeight) {
      area.width / pixelWidth
    } else {
      (area.height * 2) / pixelHeight
    };
    let columns = Geometry.clamp(1, area.width, down(pixelWidth * scale));
    let rows = Geometry.clamp(1, area.height, down((pixelHeight * scale + 1) / 2));
    (down((area.width - columns) / 2), down((area.height - rows) / 2), columns, rows, 0, 0, pixelWidth, pixelHeight)
  },
  Fill => {
    let targetRatio = area.width / (area.height * 2);
    let imageRatio = pixelWidth / pixelHeight;
    if (imageRatio > targetRatio) {
      let sourceWidth = down(pixelHeight * targetRatio);
      (0, 0, area.width, area.height, down((pixelWidth - sourceWidth) / 2), 0, sourceWidth, pixelHeight)
    } else {
      let sourceHeight = down(pixelWidth / targetRatio);
      (0, 0, area.width, area.height, 0, down((pixelHeight - sourceHeight) / 2), pixelWidth, sourceHeight)
    }
  },
  }
};

let mapping = (area, mode, pixels: Png.Pixels) => { mappingSize(area, mode, pixels.width, pixels.height) };
-- Half-block rasters use one column and two source samples per terminal cell.
-- Keep the full placement while clipping; shrinking the area would rescale it.
let viewportTarget = (area: Geometry.Rect, viewport: Geometry.Rect, mode, width, height) => {
  let (ox, oy, columns, count, sx, sy, sw, sh) = mappingSize(area, mode, width, height);
  let clipped = Geometry.intersect(Geometry.rect(area.x + ox, area.y + oy, columns, count), viewport);
  Target(clipped.x - area.x, clipped.y - area.y, clipped.width, clipped.height,
    sx + (clipped.x - area.x - ox) * sw / columns,
    sy + (clipped.y - area.y - oy) * sh / count,
    clipped.width * sw / columns, clipped.height * sh / count)
};

let cell = (pixels, sourceX, sourceY, sourceWidth, sourceHeight, columns, rows, x, y) => {
  let px = sourceX + (x + 0.5) * sourceWidth / columns;
  let pyTop = sourceY + (y * 2 + 0.5) * sourceHeight / (rows * 2);
  let pyBottom = sourceY + (y * 2 + 1.5) * sourceHeight / (rows * 2);
  let (tr, tg, tb) = pixel(pixels, px, pyTop);
  let (br, bg, bb) = pixel(pixels, px, pyBottom);
  Ansi.foregroundRgb(tr, tg, tb) ++ Ansi.backgroundRgb(br, bg, bb) ++ "▀"
};

let rec rowCells = (pixels, sourceX, sourceY, sourceWidth, sourceHeight, columns, rows, x, y) => {
  if (x >= columns) {
    ""
  } else {
    cell(pixels, sourceX, sourceY, sourceWidth, sourceHeight, columns, rows, x, y) ++
      rowCells(pixels, sourceX, sourceY, sourceWidth, sourceHeight, columns, rows, x + 1, y)
  }
};

-- Position-independent prepared rows, shared by every scroll placement/crop.
let rasterRows = (target: Target, pixels: Png.Pixels) => {
  let rec build = (y) => {
    if (y >= target.height) { [] } else {
      [rowCells(pixels, target.sourceX, target.sourceY, target.sourceWidth, target.sourceHeight,
        target.width, target.height, 0, y) ++ Ansi.reset, ..build(y + 1)]
    }
  };
  build(0)
};

let rec rows = (area, pixels, offsetX, offsetY, columns, count, sourceX, sourceY, sourceWidth, sourceHeight, y) => {
  if (y >= count) {
    ""
  } else {
    Ansi.cursorTo(area.y + offsetY + y + 1, area.x + offsetX + 1) ++
      rowCells(pixels, sourceX, sourceY, sourceWidth, sourceHeight, columns, count, 0, y) ++ Ansi.reset ++
      rows(area, pixels, offsetX, offsetY, columns, count, sourceX, sourceY, sourceWidth, sourceHeight, y + 1)
  }
};

let renderPixels = (area: Geometry.Rect, mode: Scale, pixels: Png.Pixels) => {
  if (area.width <= 0 || area.height <= 0 || pixels.width <= 0 || pixels.height <= 0) {
    ""
  } else {
    let (
      offsetX,
      offsetY, 
      columns, 
      count, 
      sourceX, 
      sourceY, 
      sourceWidth, 
      sourceHeight) 
        = mapping(area, mode, pixels);
        
    rows(area, pixels, offsetX, offsetY, columns, count, sourceX, sourceY, sourceWidth, sourceHeight, 0)
  }
};

let render = (area: Geometry.Rect, mode: Scale, image: Image) => {
  match(image.pixels) {
    Some(pixels) => { renderPixels(area, mode, pixels) },
    None => {
      if (image.base64 == "") {
        ""
      } else {
        match(Png.decode(image.base64)) {
          Err(_) => { "" },
          Ok(pixels) => { renderPixels(area, mode, pixels) },
        }
      }
    },
  }
};
