from "./png.wm" import * as Png;
from "./geometry.wm" import * as Geometry;
from js.global("Math") import unsafe { ceil: Number -> Number };

type Scale = Fit | Fill;

record Image = {
  base64: String, //TODO bruh
  alt: String,
  width: Number,
  height: Number,
  pixels: Option<Png.Pixels>,
};

-- Measure the physical height of a width-constrained image, rounded to cells.
-- The maximum is a cap, rather than a fixed-height letterbox.
let fitRows = (columns, maximum, terminal: Geometry.Size, image: Image) => {
  if (columns <= 0 || maximum <= 0 || image.width <= 0 || image.height <= 0 || terminal.cellWidth <= 0 || terminal.cellHeight <= 0) {
    0
  } else {
    Geometry.clamp(1, maximum, ceil(columns * terminal.cellWidth * image.height / (image.width * terminal.cellHeight)))
  }
};
