-- Minimal reusable Workman TUI runtime. Application state remains immutable:
-- every input callback returns the next model, which is captured by the next
-- one-shot callback.

from "./ansi.wm" import * as Ansi;
from "./command.wm" import *;
from "./event.wm" import * as Event;
from "./geometry.wm" import * as Geometry;
from "./surface.wm" import * as Surface;
from "./image-host.wm" import * as ImageHost;
from js.module("node:tty") import type { ReadStream, WriteStream };
from js.module("node:events") import { once as onceEvent };
from js.global("Deno") import { consoleSize };
from js.global("process") import unsafe {
  stdin: ReadStream,
  stdout: WriteStream,
  exit: Number -> Void,
};
from js.global("Reflect") import unsafe {
  get: (Js.Value, String) -> Option<Js.Value>,
} as Reflect;
from js.global import unsafe {
  String as toString: Js.Value -> String,
};

let errorText = match(error) => {
  Js.Error(message) => { message },
  Js.Unknown => { "unknown JavaScript error" },
};

let propertyNumber = (target, name, fallback) => {
  match(Reflect.get(target, name)) {
    None => { fallback },
    Some(raw) => {
      let decoded: Result<Number, Js.Error> = raw :> Json.assert;
      decoded :> Result.getOr(fallback)
    },
  }
};

let sizeNumber = (target: Js.Object, name, fallback) => {
  match(Reflect.get(target, name)) {
    None => { fallback },
    Some(raw) => {
      let decoded: Result<Number, Js.Error> = raw :> Json.assert;
      decoded :> Result.getOr(fallback)
    },
  }
};

let terminalSize = (output, cellWidth, cellHeight) => {
  -- node:tty's columns/rows can remain cached across resize under Deno. Query
  -- the host each time so layout and reachability use the actual viewport.
  let measured: Result<Js.Object, Js.Error> = consoleSize();
  match(measured) {
    Ok(size) => { Geometry.Size(sizeNumber(size, "columns", 80), sizeNumber(size, "rows", 24), cellWidth, cellHeight) },
    Err(_) => {
      Geometry.Size(
        propertyNumber(output, "columns", 80),
        propertyNumber(output, "rows", 24),
        cellWidth, cellHeight,
      )
    },
  }
};

let write = (output, value) => {
  output.write(value)
};

let restore = (input, output, status) => {
  ImageHost.stop();
  let _ = input.setRawMode(false);
  let _ = input.pause();
  let _ = write(output, Ansi.leave);
  exit(status);
};

let draw = (output, render, previous, running) => {
  let (model, cellWidth, cellHeight) = running;
  let size = terminalSize(output, cellWidth, cellHeight);
  write(
    output,
    render(
      previous,
      model,
      size,
    ),
  ) :> Result.map((_) => { (model, size) })
};

let rec listen = (input, output, update, render, running, previous) => {
  match(input.once("data", (chunk) => {
    let raw = toString(chunk);
    match(applyEvents(update, Event.decodeMany(raw), running)) {
      Quit => {
        restore(input, output, 0)
      },
      Continue(next) => {
        match(draw(output, render, previous, next)) {
          Err(_) => { restore(input, output, 1) },
          Ok(snapshot) => {
            listen(input, output, update, render, next, Some(snapshot))
          },
        }
      },
      Await(pendingRunning, task) => {
        match(draw(output, render, previous, pendingRunning)) {
          Err(_) => { restore(input, output, 1) },
          Ok(pendingSnapshot) => {
            let _ = task
              :> Task.map((nextRunning) => {
                match(draw(
                  output,
                  render,
                  Some(pendingSnapshot),
                  nextRunning,
                )) {
                  Err(_) => { restore(input, output, 1) },
                  Ok(snapshot) => {
                    listen(
                      input,
                      output,
                      update,
                      render,
                      nextRunning,
                      Some(snapshot),
                    )
                  },
                }
              })
              :> Task.recover((_) => {
                restore(input, output, 1)
              });
            void
          },
        }
      },
      Spawn(_pending, _task) => {
        restore(input, output, 1)
      },
      SpawnMany(_pending, _tasks) => {
        restore(input, output, 1)
      },
    }
  })) {
    Ok(_) => { void },
    Err(_) => { restore(input, output, 1) },
  }
};

let run = (initial, update, render) => {
  let input = stdin;
  let output = stdout;
  match(input.setRawMode(true)) {
    Err(error) => {
      print("could not enable raw mode (is stdin a terminal?): " ++ errorText(error))
    },
    Ok(_) => {
      let initialRunning = (initial, 1, 2);
      let initialSize = terminalSize(output, 1, 2);
      let _ = input.resume();
      match(write(
        output,
        Ansi.enter ++ Ansi.queryCellSize ++
          render(None, initial, initialSize),
      )) {
        Err(_) => { restore(input, output, 1) },
        Ok(_) => {
          listen(
            input,
            output,
            update,
            render,
            initialRunning,
            Some((initial, initialSize)),
          )
        },
      }
    },
  }
};

let drawRetained = (output, render, memory, running) => {
  let (model, cellWidth, cellHeight) = running;
  let size = terminalSize(output, cellWidth, cellHeight);
  let frame = render(memory, model, size);
  write(output, frame.output) :> Result.map((_) => { frame.memory })
};

let inputEvents = (input) => {
  onceEvent(input, "data")
    :> Task.andThen((values) => {
      match(Js.Array.toList(values)) {
        [] => { Task.succeed([]) },
        [chunk, .._] => {
          toString(chunk)
            :> Task.succeed
            :> Task.map(Event.decodeMany)
        },
      }
    })
};

let prepareApplied = (applied, output, memory, prepare) => {
  match(applied) {
    AppliedQuit => { AppliedQuit },
    Applied(preparedRunning, tasks) => {
      let (model, cw, ch) = preparedRunning;
      match(settleStep(prepare(model, terminalSize(output, cw, ch), Some(memory)))) {
        SettledQuit => { AppliedQuit },
        Settled(next, extra) => { Applied((next, cw, ch), List.append(tasks, extra)) },
      }
    },
  }
};

let rec waitRetained = (
  input,
  output,
  update,
  render,
  running,
  memory,
  pending,
  nextId,
  inputTask,
  settle,
  prepare,
) => {
  let _ = nextWake(inputTask, pending)
    :> Task.map((wake) => {
      match(wake) {
        InputWake(events) => {
          match(prepareApplied(applyConcurrent((key, state) => { update(key, state, memory) }, events, running), output, memory, prepare)) {
            AppliedQuit => {
              restore(input, output, 0)
            },
            Applied(next, tasks) => {
              match(drawRetained(output, render, Some(memory), next)) {
                Err(_) => { restore(input, output, 1) },
                Ok(nextMemory) => {
                  let queued = enqueue(tasks, pending, nextId);
                  let (nextPending, followingId) = queued;
                  waitRetained(
                    input,
                    output,
                    update,
                    render,
                    next,
                    nextMemory,
                    nextPending,
                    followingId,
                    inputEvents(input),
                    settle,
                    prepare,
                  )
                },
              }
            },
          }
        },
        TaskWake(id, patch) => {
          let (model, cellWidth, cellHeight) = running;
          match(settleStep(prepareStep(settle(patch(model)), (state) => { prepare(state, terminalSize(output, cellWidth, cellHeight), Some(memory)) }))) {
            SettledQuit => {
              restore(input, output, 0)
            },
            Settled(nextModel, tasks) => {
              let next = (nextModel, cellWidth, cellHeight);
              match(drawRetained(output, render, Some(memory), next)) {
                Err(_) => { restore(input, output, 1) },
                Ok(nextMemory) => {
                  let remaining = removePending(id, pending);
                  let queued = enqueue(tasks, remaining, nextId);
                  let (nextPending, followingId) = queued;
                  waitRetained(
                    input,
                    output,
                    update,
                    render,
                    next,
                    nextMemory,
                    nextPending,
                    followingId,
                    inputTask,
                    settle,
                    prepare,
                  )
                },
              }
            },
          }
        },
      }
    })
    :> Task.recover((_) => {
      restore(input, output, 1)
    });
  void
};

let rec listenRetained = (input, output, update, render, running, memory) => {
  match(input.once("data", (chunk) => {
    let raw = toString(chunk);
    match(applyEvents(update, Event.decodeMany(raw), running)) {
      Quit => {
        restore(input, output, 0)
      },
      Continue(next) => {
        match(drawRetained(output, render, Some(memory), next)) {
          Err(_) => { restore(input, output, 1) },
          Ok(nextMemory) => {
            listenRetained(
              input,
              output,
              update,
              render,
              next,
              nextMemory,
            )
          },
        }
      },
      Await(pendingRunning, task) => {
        match(drawRetained(
          output,
          render,
          Some(memory),
          pendingRunning,
        )) {
          Err(_) => { restore(input, output, 1) },
          Ok(pendingMemory) => {
            let _ = task
              :> Task.map((nextRunning) => {
                match(drawRetained(
                  output,
                  render,
                  Some(pendingMemory),
                  nextRunning,
                )) {
                  Err(_) => { restore(input, output, 1) },
                  Ok(nextMemory) => {
                    listenRetained(
                      input,
                      output,
                      update,
                      render,
                      nextRunning,
                      nextMemory,
                    )
                  },
                }
              })
              :> Task.recover((_) => {
                restore(input, output, 1)
              });
            void
          },
        }
      },
      Spawn(_pending, _task) => {
        restore(input, output, 1)
      },
      SpawnMany(_pending, _tasks) => {
        restore(input, output, 1)
      },
    }
  })) {
    Ok(_) => { void },
    Err(_) => { restore(input, output, 1) },
  }
};

let runRetainedManagedPreparedContext = (
  initial,
  initialTasks,
  settle,
  prepare,
  update,
  render,
) => {
  let input = stdin;
  let output = stdout;
  match(input.setRawMode(true)) {
    Err(error) => {
      print("could not enable raw mode (is stdin a terminal?): " ++ errorText(error))
    },
    Ok(_) => {
      ImageHost.start((value) => { let _ = write(output, value); void });
      let initialSize = terminalSize(output, 1, 2);
      match(settleStep(prepare(initial, initialSize, None))) {
        SettledQuit => { restore(input, output, 0) },
        Settled(prepared, preparedTasks) => {
          let initialRunning = (prepared, 1, 2);
          let initialFrame = render(None, prepared, initialSize);
          let _ = input.resume();
          match(write(
            output,
            Ansi.enter ++ Ansi.queryCellSize ++ initialFrame.output,
          )) {
            Err(_) => { restore(input, output, 1) },
            Ok(_) => {
              let queued = enqueue(List.append(initialTasks, preparedTasks), [], 0);
              let (pending, nextId) = queued;
              waitRetained(
                input,
                output,
                update,
                render,
                initialRunning,
                initialFrame.memory,
                pending,
                nextId,
                inputEvents(input),
                settle,
                prepare,
              )
            },
          }
        },
      }
    },
  }
};

-- Contextual input sees exactly the retained frame that was last painted.
let runRetainedManagedPrepared = (initial, tasks, settle, prepare, update, render) => {
  runRetainedManagedPreparedContext(initial, tasks, settle, prepare,
    (key, state, _memory) => { update(key, state) }, render)
};

-- Preparation receives actual terminal geometry and previous retained memory
-- before every paint, including startup, input, and background completion.
let runRetainedManaged = (initial, tasks, settle, update, render) => {
  runRetainedManagedPrepared(initial, tasks, settle,
    (state, _size, _memory) => { Continue(state) }, update, render)
};

let runRetainedWith = (initial, initialTasks, update, render) => {
  runRetainedManaged(
    initial,
    initialTasks,
    (state) => { Continue(state) },
    update,
    render,
  )
};

let runRetained = (initial, update, render) => {
  runRetainedWith(initial, [], update, render)
};
