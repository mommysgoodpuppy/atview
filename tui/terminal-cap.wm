from js.global("Deno") import unsafe * as Deno;

-- The terminal's detected image protocol.
type Backend =
  | KittyGraphics
  | Sixel
  | HalfBlock;

-- What we actually render with. Consumers match on this instead
-- of `backend` so that adding a new detected protocol never
-- creates dead arms in rendering code.
type Renderer =
  | KittyRenderer
  | SixelRenderer
  | HalfBlockRenderer;

let envString = (name) => {
  match(Deno.env.get(name)) {
    Err(_) => { "" },
    Ok(None) => { "" },
    Ok(Some(value)) => { value },
  }
};

let textIncludes = (haystack, needle) => {
  match(haystack :> .indexOf(needle)) {
    Ok(index) => { index >= 0 },
    Err(_) => { false },
  }
};

let nonEmpty = (value) => {
  value != ""
};

-- Terminals that implement the Kitty graphics protocol.
-- Kitty, Ghostty, WezTerm, and Konsole 24.12+ transmit inline
-- images through APC chunks. Terminals that do not understand
-- APC silently ignore it, so a false positive degrades to "no
-- image" rather than screen corruption.
let supportsKittyGraphics = () => {
  let term = envString("TERM");
  let termProgram = envString("TERM_PROGRAM");
  nonEmpty(envString("KITTY_WINDOW_ID")) ||
  nonEmpty(envString("GHOSTTY_RESOURCES_DIR")) ||
  nonEmpty(envString("WEZTERM_EXECUTABLE")) ||
  termProgram == "ghostty" ||
  termProgram == "WezTerm" ||
  termProgram == "konsole" ||
  textIncludes(term, "kitty") ||
  textIncludes(term, "ghostty") ||
  textIncludes(term, "wezterm")
};

-- Terminals known to support sixel graphics. Static env-var
-- detection is imperfect — a sixel terminal not listed here
-- falls back to half-block, and a false positive prints raw sixel
-- bytes. Set ATVIEW_IMAGE_BACKEND to override the guess.
let supportsSixel = () => {
  let term = envString("TERM");
  let termProgram = envString("TERM_PROGRAM");
  nonEmpty(envString("WT_SESSION")) ||
  termProgram == "mintty" ||
  textIncludes(term, "foot") ||
  textIncludes(term, "mlterm") ||
  textIncludes(term, "contour")
};

let detectBackend = () => {
  match(envString("ATVIEW_IMAGE_BACKEND")) {
    "kitty" => { KittyGraphics },
    "sixel" => { Sixel },
    "half" => { HalfBlock },
    "ansi" => { HalfBlock },
    "halfblock" => { HalfBlock },
    _ => {
      if (supportsKittyGraphics()) {
        KittyGraphics
      } else {
        if (supportsSixel()) {
          Sixel
        } else {
          HalfBlock
        }
      }
    },
  }
};

let backendName = match(backend) => {
  KittyGraphics => { "kitty" },
  Sixel => { "sixel" },
  HalfBlock => { "half-block" },
};

let backend = detectBackend();

-- Maps the detected protocol to what we can actually render with.
let renderer = match(backend) {
  KittyGraphics => { KittyRenderer },
  Sixel => { SixelRenderer },
  HalfBlock => { HalfBlockRenderer },
};
