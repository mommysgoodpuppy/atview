from "./png.wm" import * as Png;
from js.module("jsr:@img/png@0.1.6") import { decodePNG };
from js.module("node:buffer") import { Buffer };
from js.global("Uint8Array") import { from as copyArray };

record Header = {
  width: Number,
  height: Number,
};

record Decoded = {
  header: Header,
  body: Js.Value,
};

let decode = (buffer) => {
  copyArray(buffer) :> Task.fromResult :> Task.andThen((bytes) => { decodePNG(bytes) })
    :> Task.andThen((raw) => {
      let decoded: Result<Decoded, Js.Error> = raw :> Json.assert;
      decoded :> Task.fromResult
    })
    :> Task.andThen((decoded) => {
      Buffer.copyBytesFrom(decoded.body) :> Task.fromResult :> Task.map((body) => {
        Png.Pixels(body, decoded.header.width, decoded.header.height)
      })
    })
};
