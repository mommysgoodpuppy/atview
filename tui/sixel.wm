from js.global("String.prototype.fromCharCode") import unsafe {
  call as fromCharCode: Number -> Number
};

record Rgba = { 
  r: Number,
  g: Number,
  b: Number,
  a: Number
};

record Rgb = { 
  r: Number,
  g: Number,
  b: Number,
};

record ImageRgba = { 
  width: Number,
  height: Number,
  pixels: List<Rgba>
};

type Pixel = Transparent | Color<Number>;

record IndexedImage = {
  width:Number,
  height:Number,
  pixels: List<Pixel>,
  palette: List<Rgb>
};

