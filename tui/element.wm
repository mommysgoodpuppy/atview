-- Declarative terminal composition using ordinary Workman values.
--
-- Components are functions returning Element. Fragment provides JSX-like
-- nesting without custom syntax, and render is the single ANSI/Kitty
-- interpretation boundary.

from "./draw.wm" import * as Draw;
from "./geometry.wm" import * as Geometry;
from "./image.wm" import * as Image;
from "./image-host.wm" import * as ImageHost;
from "./resource.wm" import * as Resource;

type Element =
  | Empty
  | Fragment<List<Element>>
  | Text<Geometry.Rect, String, Draw.Style>
  | Lines<Geometry.Rect, List<String>, Draw.Style>
  | TextViewport<Geometry.Rect, Geometry.Rect, String, String, Draw.Style>
  | LinesViewport<Geometry.Rect, Geometry.Rect, List<String>, String, Draw.Style>
  | Fill<Geometry.Rect, String, Draw.Style>
  | Box<Geometry.Rect, String, Bool>
  | TimelineBox<Geometry.Rect, Bool, Bool, Bool>
  | ImageViewport<Number, Geometry.Rect, Geometry.Rect, Image.Scale, Image.Image>
  | Image<Number, Geometry.Rect, Image.Scale, Image.Image>;

let empty = Empty;

let fragment = (children) => {
  Fragment(children)
};

let text = (area, value, style) => {
  Text(area, value, style)
};

let lines = (area, values, style) => {
  Lines(area, values, style)
};

let textViewport = (area, viewport, value, marker, style) => {
  TextViewport(area, viewport, value, marker, style)
};
let linesViewport = (area, viewport, values, marker, style) => {
  LinesViewport(area, viewport, values, marker, style)
};
let ellipsizedText = (area, value, style) => {
  TextViewport(area, area, value, "..", style)
};

let fill = (area, symbol, style) => {
  Fill(area, symbol, style)
};

let box = (area, title, active) => {
  Box(area, title, active)
};

let timelineBox = (area, active, joinedTop, joinedBottom) => {
  TimelineBox(area, active, joinedTop, joinedBottom)
};

let image = (identifier, area, scale, value) => {
  Image(identifier, area, scale, value)
};

let imageViewport = (identifier, area, viewport, scale, value) => {
  ImageViewport(identifier, area, viewport, scale, value)
};

let showIf = (condition, element) => {
  if (condition) { element } else { Empty }
};

let optional = match(value, present) => {
  (None, _) => { Empty },
  (Some(item), _) => { present(item) },
};

let suspense = (resource, pending, failed, ready) => {
  Resource.resolve(resource, pending, failed, ready)
};

let rec render = match(terminal, element) => {
  (_, Empty) => { "" },
  (_, Fragment(children)) => {
    let rec renderChildren = match(remaining) => {
      [] => { "" },
      [child, ..rest] => {
        render(terminal, child) ++ renderChildren(rest)
      },
    };
    renderChildren(children)
  },
  (_, Text(area, value, style)) => {
    Draw.text(area, value, style)
  },
  (_, Lines(area, values, style)) => {
    Draw.lines(area, values, style)
  },
  (_, TextViewport(area, viewport, value, marker, style)) => {
    Draw.textViewport(area, viewport, value, marker, style)
  },
  (_, LinesViewport(area, viewport, values, marker, style)) => {
    Draw.linesViewport(area, viewport, values, marker, style)
  },
  (_, Fill(area, symbol, style)) => {
    Draw.fill(area, symbol, style)
  },
  (_, Box(area, title, active)) => {
    Draw.box(area, title, active)
  },
  (_, TimelineBox(area, active, joinedTop, joinedBottom)) => {
    Draw.timelineBox(area, active, joinedTop, joinedBottom)
  },
  (_, ImageViewport(identifier, area, viewport, scale, value)) => {
    ImageHost.renderClipped(identifier, area, viewport, terminal, scale, value)
  },
  (_, Image(identifier, area, scale, value)) => {
    ImageHost.render(identifier, area, terminal, scale, value)
  },
};

-- Text-only repaint of an existing layout preserves all image placements.
let rec withoutImages = match(element) => {
  ImageViewport(_, _, _, _, _) => { Empty },
  Image(_, _, _, _) => { Empty },
  Fragment(children) => { Fragment(children :> List.map(withoutImages)) },
  _ => { element },
};

-- Prepare image output without painting text or creating terminal placements.
let rec preload = match(terminal, element) => {
  (_, Fragment(children)) => {
    List.foldLeft(children, void, (_acc, child) => { preload(terminal, child) })
  },
  (_, ImageViewport(_identifier, area, viewport, scale, value)) => {
    let _ = ImageHost.preloadClipped(area, viewport, terminal, scale, value); void
  },
  (_, Image(_identifier, area, scale, value)) => {
    let _ = ImageHost.preloadClipped(area, area, terminal, scale, value); void
  },
  _ => { void },
};

-- Nearby preparation uses a larger resource viewport than the paint clip. It
-- never emits terminal output, including for negative/offscreen coordinates.
let rec preloadWithin = match(terminal, nearby, element) => {
  (_, _, Fragment(children)) => {
    List.foldLeft(children, void, (_acc, child) => { preloadWithin(terminal, nearby, child) })
  },
  (_, _, ImageViewport(_identifier, area, _viewport, scale, value)) => {
    let _ = ImageHost.preloadClipped(area, nearby, terminal, scale, value); void
  },
  (_, _, Image(_identifier, area, scale, value)) => {
    let _ = ImageHost.preloadClipped(area, nearby, terminal, scale, value); void
  },
  _ => { void },
};
