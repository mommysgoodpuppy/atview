-- Retained terminal surfaces. Regions keep only their projected dependencies;
-- changed regions stage typed host commands, which are encoded at the terminal
-- boundary. This is the immutable Workman counterpart of signal/effect
-- invalidation rather than a whole-model rerender contract.

from "./draw.wm" import * as Draw;
from "./geometry.wm" import * as Geometry;
from "./image.wm" import * as Image;
from "./image-host.wm" import * as ImageHost;

type Command =
  | Raw<String>
  | Text<Geometry.Rect, String, Draw.Style>
  | Fill<Geometry.Rect, String, Draw.Style>
  | TextViewport<Geometry.Rect, Geometry.Rect, String, String, Draw.Style>
  | LinesViewport<Geometry.Rect, Geometry.Rect, List<String>, String, Draw.Style>
  | DeleteAllImages
  | DeleteImage<Number>
  | PlaceImageViewport<Number, Geometry.Rect, Geometry.Rect, Image.Scale, Image.Image>
  | PlaceImage<Number, Geometry.Rect, Image.Scale, Image.Image>;

record Frame<Memory> = {
  output: String,
  memory: Memory,
};

let rec encode = match(commands, terminal) => {
  ([], _) => { "" },
  ([command, ..tail], _) => {
    let output = match(command) {
      Raw(value) => { value },
      Text(area, value, style) => { Draw.text(area, value, style) },
      Fill(area, symbol, style) => { Draw.fill(area, symbol, style) },
      TextViewport(area, viewport, value, marker, style) => {
        Draw.textViewport(area, viewport, value, marker, style)
      },
      LinesViewport(area, viewport, values, marker, style) => {
        Draw.linesViewport(area, viewport, values, marker, style)
      },
      DeleteAllImages => { ImageHost.deleteAll() },
      DeleteImage(identifier) => { ImageHost.deleteImage(identifier) },
      PlaceImageViewport(identifier, area, viewport, scale, image) => {
        ImageHost.renderClipped(identifier, area, viewport, terminal, scale, image)
      },
      PlaceImage(identifier, area, scale, image) => {
        ImageHost.render(identifier, area, terminal, scale, image)
      },
    };
    output ++ encode(tail, terminal)
  },
};

let frame = (memory, terminal, commands) => {
  Frame(encode(commands, terminal), memory)
};
