-- Retained terminal surfaces. Regions keep only their projected dependencies;
-- changed regions stage typed host commands, which are encoded at the terminal
-- boundary. This is the immutable Workman counterpart of signal/effect
-- invalidation rather than a whole-model rerender contract.

from "./draw.wm" import * as Draw;
from "./geometry.wm" import * as Geometry;
from "./halfblock.wm" import * as HalfBlock;
from "./kitty.wm" import * as Kitty;
from "./image.wm" import * as Image;
from "./terminal-cap.wm" import * as Cap;

type Command =
  | Raw<String>
  | Text<Geometry.Rect, String, Draw.Style>
  | Fill<Geometry.Rect, String, Draw.Style>
  | DeleteAllImages
  | DeleteImage<Number>
  | PlaceImage<Number, Geometry.Rect, Image.Scale, Image.Image>;

record Frame<Memory> = {
  output: String,
  memory: Memory,
};

let rec encode = match(commands, terminal) => {
  ([], _) => { "" },
  ([command, ..tail], _) => {
    let output = match(command) {
      Raw(value) => { value },
      Text(area, value, style) => { Draw.text(area, value, style) },
      Fill(area, symbol, style) => { Draw.fill(area, symbol, style) },
      DeleteAllImages => {
        match(Cap.renderer) {
          Cap.KittyRenderer => { Kitty.deleteAll },
          Cap.HalfBlockRenderer => { "" },
        }
      },
      DeleteImage(identifier) => {
        match(Cap.renderer) {
          Cap.KittyRenderer => { Kitty.deleteImage(identifier) },
          Cap.HalfBlockRenderer => { "" },
        }
      },
      PlaceImage(identifier, area, scale, image) => {
        match(Cap.renderer) {
          Cap.KittyRenderer => { Kitty.renderWithId(identifier, area, terminal, scale, image) },
          Cap.HalfBlockRenderer => { HalfBlock.render(area, scale, image) },
        }
      },
    };
    output ++ encode(tail, terminal)
  },
};

let frame = (memory, terminal, commands) => {
  Frame(encode(commands, terminal), memory)
};
