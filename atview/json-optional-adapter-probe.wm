from js.global("JSON") import {
  parse: (String) => Js.Object,
} as JSON;
from js.global("Reflect") import {
  get: (Js.Object, String) => Option<Js.Value>,
} as Reflect;

let optionalString = (body, key) => {
  Reflect.get(body, key) :> Result.andThen((found) => {
    match(found) {
      None => { Ok(None) },
      Some(raw) => {
        let value: Result<String, Js.Error> = raw :> Json.assert;
        value :> Result.map(Some)
      },
    }
  })
};

let describe = (label, parsed) => {
  match(parsed :> Result.andThen((body) => { optionalString(body, "optional") })) {
    Ok(Some(text)) => { print(label ++ ": Some(" ++ text ++ ")") },
    Ok(None) => { print(label ++ ": None") },
    Err(Js.Error(message)) => { print(label ++ ": " ++ message) },
    Err(Js.Unknown) => { print(label ++ ": unknown error") },
  }
};

let main = () => {
  describe("missing", JSON.parse("{\"required\":\"yes\"}"));
  describe("present", JSON.parse("{\"required\":\"yes\",\"optional\":\"hello\"}"));
  describe("null", JSON.parse("{\"required\":\"yes\",\"optional\":null}"))
};
