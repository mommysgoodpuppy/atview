-- Bluesky application model shared by loading, scheduling, updating, and rendering.

from "./config.wm" import * as Config;
from "../proto/api.wm" import { FeedPost };
from "../proto/views.wm" import * as Views;
from "../proto/xrpc.wm" import { AppError };
from "../tui/geometry.wm" import * as Geometry;
from "../tui/kitty.wm" import * as Kitty;
from "../tui/image.wm" import * as Image;
from "../tui/resource.wm" import * as Resource;
from "../tui/scroll.wm" import * as Scroll;

type FeedView = Timeline | OwnPosts | GeneratorFeed<String> | ListTimeline<String>;

type UiThread =
  | UiThreadPost<Views.Post, Option<Image.Image>, List<UiThread>>
  | UiMissingPost<String>
  | UiBlockedPost<String>
  | UiUnknownThread<String>;

type ThreadModel =
  | ThreadLoading<String>
  | ThreadReady<String, UiThread>
  | ThreadFailed<String, String>;

type ThreadResource =
  | ThreadPending
  | ThreadCached<UiThread>
  | ThreadCacheFailed<String>;

record ThreadNode = {
  uri: String,
  resource: ThreadResource,
};

record UiPost = {
  post: FeedPost,
  image: Resource.Resource<String, Option<Image.Image>>,
  avatar: Resource.Resource<String, Option<Image.Image>>,
};

record FeedTab = {
  view: FeedView,
  title: String,
  posts: List<UiPost>,
  cursor: Option<String>,
  loaded: Bool,
  loading: Bool,
  status: String,
  selected: Number,
  scrollRows: Number,
};

record PostReaction = {
  uri: String,
  viewerLike: Option<String>,
  likeCount: Option<Number>,
  pending: Bool,
};

record UiFeeds = {
  settings: Config.Settings,
  handle: String,
  did: String,
  accessJwt: String,
  tabs: List<FeedTab>,
  reactions: List<PostReaction>,
  reactionVersion: Number,
  preloadVersion: Number,
};

let sameView = match(left, right) => {
  (Timeline, Timeline) => { true },
  (OwnPosts, OwnPosts) => { true },
  (GeneratorFeed(left), GeneratorFeed(right)) => { left == right },
  (ListTimeline(left), ListTimeline(right)) => { left == right },
  _ => { false },
};
let emptyTab = (view, title) => {
  FeedTab(view, title, [], None, false, false, "", 0, 0)
};
let makeUiFeeds = (handle, did, jwt, timeline, own, timelineCursor, ownCursor) => {
  UiFeeds(Config.defaults, handle, did, jwt, [
    FeedTab(Timeline, "Following", timeline, timelineCursor, true, false, "", 0, 0),
    FeedTab(OwnPosts, "My posts", own, ownCursor, true, false, "", 0, 0),
  ], [], 0, 0)
};
let tabFor = (feeds: UiFeeds, view) => {
  List.find(feeds.tabs, (tab) => { sameView(tab.view, view) })
};
let tabValue = (feeds: UiFeeds, view) => {
  tabFor(feeds, view) :> Option.getOr(emptyTab(view, "Feed"))
};
let modifyTab = (feeds: UiFeeds, view, transform) => {
  .{ ..feeds, preloadVersion = feeds.preloadVersion + 1, tabs = feeds.tabs :> List.map((tab) => {
    if (sameView(tab.view, view)) { transform(tab) } else { tab }
  }) }
};

record UiState = {
  selected: Number,
  view: FeedView,
  imageScale: Image.Scale,
  feeds: UiFeeds,
  loading: Bool,
  status: String,
  renderVersion: Number,
  thread: ThreadModel,
  threadGraph: List<ThreadNode>,
  scrolling: Bool,
  scrollVersion: Number,
  scrollFrame: Number,
  scrollRows: Number,
};

record FeedLayout = {
  thumbnail: Bool,
  width: Number,
  size: Geometry.Size,
  scale: Image.Scale,
};

record CardCursor = {
  selected: Number,
  index: Number,
};

record PaneLayout = {
  feed: Geometry.Rect,
  thread: Geometry.Rect,
};

record ReplyCursor = {
  depth: Number,
  row: Number,
  imageId: Number,
};

record BoundedThreadNodes = {
  nodes: List<Views.Thread>,
  remaining: Number,
};

record PrefetchPlan = {
  state: UiState,
  tasks: List<Task<UiState -> UiState, AppError>>,
};

record MediaPlan = {
  state: UiState,
  tasks: List<Task<UiState -> UiState, AppError>>,
};

record GraphCounts = {
  ready: Number,
  pending: Number,
};

record BorderRender = {
  cursor: CardCursor,
  layout: FeedLayout,
  target: Number,
  active: Bool,
  standalone: Bool,
};

record FeedRegion = {
  renderVersion: Number,
  scrolling: Bool,
  start: Number,
  scrollOffset: Number,
  size: Geometry.Size,
};

record SelectionRegion = {
  selected: Number,
  start: Number,
};

record ThreadRegion = {
  selected: Number,
  scrolling: Bool,
  renderVersion: Number,
  imageScale: Image.Scale,
  threadKey: String,
  size: Geometry.Size,
};

record MediaRegion = {
  scrolling: Bool,
  start: Number,
  size: Geometry.Size,
};

record FooterRegion = {
  selected: Number,
  count: Number,
  view: FeedView,
  loading: Bool,
  status: String,
  graphReady: Number,
  graphPending: Number,
  size: Geometry.Size,
};

type RenderDependency =
  | SelectionSurface
  | MediaSurface
  | ThreadSurface
  | FooterSurface
  | TabsSurface
  | ReactionSurface;

record RenderModel = {
  state: UiState,
  size: Geometry.Size,
  start: Number,
  scrollInset: Number,
  scrollOffset: Number,
  scrollTarget: Number,
  tabScroll: Scroll.Motion,
};

let rec graphCounts = match(graph) => {
  [] => { GraphCounts(0, 0) },
  [node, ..rest] => {
    let tail = graphCounts(rest);
    match(node.resource) {
      ThreadPending => {
        GraphCounts(tail.ready, tail.pending + 1)
      },
      ThreadCached(_) => {
        GraphCounts(tail.ready + 1, tail.pending)
      },
      ThreadCacheFailed(_) => {
        GraphCounts(tail.ready, tail.pending)
      },
    }
  },
};

let phoneAspect = (body: Geometry.Rect, size: Geometry.Size) => {
  let pixelWidth = body.width * size.cellWidth;
  let pixelHeight = body.height * size.cellHeight;
  body.width < 56 || pixelWidth * 3 < pixelHeight * 4
};

let panes = (body, size) => {
  if (phoneAspect(body, size)) {
    PaneLayout(body, Geometry.rect(body.x + body.width, body.y, 0, body.height))
  } else {
    let requested = Geometry.aspectColumns(body.height, size, 9, 19.5);
    let leftWidth = Geometry.clamp(20, body.width - 31, requested);
    let (feed, thread) = Geometry.splitColumns(body, leftWidth, 1);
    PaneLayout(feed, thread)
  }
};

let mediaValue = (resource) => {
  Resource.getOr(None, resource)
};

let countText = (value) => {
  value :> Option.map(Text.of) :> Option.getOr("0")
};

let move = (count, delta, state) => {
  let selected = Geometry.clamp(0, Geometry.nonNegative(count - 1), state.selected + delta);
  UiState(
    selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    state.renderVersion,
    state.thread,
    state.threadGraph,
    state.scrolling,
    state.scrollVersion,
    state.scrollFrame,
    state.scrollRows,
  )
};

let toggleImageScale = match(scale) => {
  Image.Fit => { Image.Fill },
  Image.Fill => { Image.Fit },
};

let imageScaleName = match(scale) => {
  Image.Fit => { "fit" },
  Image.Fill => { "fill" },
};

let postsFor = (feeds, view) => {
  let tab = tabValue(feeds, view);
  tab.posts
};

let hideMedia = match(resource) => {
  Resource.Ready(Some(_)) => { Resource.Loading },
  _ => { resource },
};

-- Visibility is a drawing concern: retain media metadata for stable layout.
let postsForState = (state: UiState) => {
  postsFor(state.feeds, state.view)
};

let titleFor = (feeds, view) => {
  let tab = tabValue(feeds, view);
  tab.title
};

-- Keep one row for tabs and one for the footer in every pane calculation.
let contentBody = (size: Geometry.Size) => {
  Geometry.rect(0, 1, size.width, Geometry.nonNegative(size.height - 2))
};

let activeTabIndex = (state: UiState) => {
  let rec find = match(tabs, index) => {
    ([], _) => { 0 },
    ([tab, ..tail], _) => {
      if (sameView(tab.view, state.view)) { index } else { find(tail, index + 1) }
    },
  };
  find(state.feeds.tabs, 0)
};

let heart = match(like) => { None => { "" }, Some(_) => { "❤️ " } };
let selectedLikePending = (state: UiState) => {
  match(List.at(postsForState(state), state.selected)) {
    None => { false },
    Some(item) => {
      List.any(state.feeds.reactions, (reaction) => { reaction.uri == item.post.uri && reaction.pending })
    },
  }
};
let footerStatus = (state: UiState) => {
  if (selectedLikePending(state)) { "saving like…" } else { state.status }
};

let feedLayout = (width, size, state: UiState) => { FeedLayout(state.feeds.settings.timelineThumbnailMode, width, size, state.imageScale) };
