-- Bluesky application model shared by loading, scheduling, updating, and rendering.

from "../proto/api.wm" import { FeedPost };
from "../proto/views.wm" import * as Views;
from "../proto/xrpc.wm" import { AppError };
from "../tui/geometry.wm" import * as Geometry;
from "../tui/kitty.wm" import * as Kitty;
from "../tui/image.wm" import * as Image;
from "../tui/resource.wm" import * as Resource;

type FeedView = Timeline | OwnPosts;

type UiThread =
  | UiThreadPost<Views.Post, Option<Image.Image>, List<UiThread>>
  | UiMissingPost<String>
  | UiBlockedPost<String>
  | UiUnknownThread<String>;

type ThreadModel =
  | ThreadLoading<String>
  | ThreadReady<String, UiThread>
  | ThreadFailed<String, String>;

type ThreadResource =
  | ThreadPending
  | ThreadCached<UiThread>
  | ThreadCacheFailed<String>;

record ThreadNode = {
  uri: String,
  resource: ThreadResource,
};

record UiPost = {
  post: FeedPost,
  image: Resource.Resource<String, Option<Image.Image>>,
  avatar: Resource.Resource<String, Option<Image.Image>>,
};

record UiFeeds = {
  handle: String,
  did: String,
  accessJwt: String,
  timelinePosts: List<UiPost>,
  ownPosts: List<UiPost>,
  timelineCursor: Option<String>,
  ownCursor: Option<String>,
};

record UiState = {
  selected: Number,
  view: FeedView,
  imageScale: Image.Scale,
  feeds: UiFeeds,
  loading: Bool,
  status: String,
  renderVersion: Number,
  thread: ThreadModel,
  threadGraph: List<ThreadNode>,
  scrolling: Bool,
  scrollVersion: Number,
  scrollFrame: Number,
  scrollRows: Number,
};

record FeedLayout = {
  width: Number,
  size: Geometry.Size,
  scale: Image.Scale,
};

record WindowLayout = {
  width: Number,
  height: Number,
  size: Geometry.Size,
  scale: Image.Scale,
};

record CardCursor = {
  selected: Number,
  index: Number,
};

record PostRows = {
  first: String,
  second: String,
};

record PaneLayout = {
  feed: Geometry.Rect,
  thread: Geometry.Rect,
};

record ReplyCursor = {
  depth: Number,
  row: Number,
  imageId: Number,
};

record BoundedThreadNodes = {
  nodes: List<Views.Thread>,
  remaining: Number,
};

record PrefetchPlan = {
  state: UiState,
  tasks: List<Task<UiState -> UiState, AppError>>,
};

record MediaPlan = {
  state: UiState,
  tasks: List<Task<UiState -> UiState, AppError>>,
};

record GraphCounts = {
  ready: Number,
  pending: Number,
};

record BorderRender = {
  cursor: CardCursor,
  layout: FeedLayout,
  target: Number,
  active: Bool,
  standalone: Bool,
};

record FeedRegion = {
  renderVersion: Number,
  scrolling: Bool,
  start: Number,
  scrollOffset: Number,
  size: Geometry.Size,
};

record SelectionRegion = {
  selected: Number,
  start: Number,
};

record ThreadRegion = {
  selected: Number,
  scrolling: Bool,
  renderVersion: Number,
  imageScale: Image.Scale,
  threadKey: String,
  size: Geometry.Size,
};

record MediaRegion = {
  scrolling: Bool,
  start: Number,
  size: Geometry.Size,
};

record FooterRegion = {
  selected: Number,
  count: Number,
  view: FeedView,
  loading: Bool,
  status: String,
  graphReady: Number,
  graphPending: Number,
  size: Geometry.Size,
};

type RenderDependency =
  | SelectionSurface
  | MediaSurface
  | ThreadSurface
  | FooterSurface;

record RenderModel = {
  state: UiState,
  size: Geometry.Size,
  start: Number,
  scrollOffset: Number,
  scrollTarget: Number,
};

let rec graphCounts = match(graph) => {
  [] => { GraphCounts(0, 0) },
  [node, ..rest] => {
    let tail = graphCounts(rest);
    match(node.resource) {
      ThreadPending => {
        GraphCounts(tail.ready, tail.pending + 1)
      },
      ThreadCached(_) => {
        GraphCounts(tail.ready + 1, tail.pending)
      },
      ThreadCacheFailed(_) => {
        GraphCounts(tail.ready, tail.pending)
      },
    }
  },
};

let phoneAspect = (body: Geometry.Rect, size: Geometry.Size) => {
  let pixelWidth = body.width * size.cellWidth;
  let pixelHeight = body.height * size.cellHeight;
  body.width < 56 || pixelWidth * 3 < pixelHeight * 4
};

let panes = (body, size) => {
  if (phoneAspect(body, size)) {
    PaneLayout(body, Geometry.rect(body.x + body.width, body.y, 0, body.height))
  } else {
    let requested = Geometry.aspectColumns(body.height, size, 9, 19.5);
    let leftWidth = Geometry.clamp(20, body.width - 31, requested);
    let (feed, thread) = Geometry.splitColumns(body, leftWidth, 1);
    PaneLayout(feed, thread)
  }
};

let mediaValue = (resource) => {
  Resource.withDefault(None, resource)
};

let countText = (value) => {
  value :> Option.map(Text.of) :> Option.withDefault("0")
};

let move = (count, delta, state) => {
  let selected = Geometry.clamp(0, count - 1, state.selected + delta);
  UiState(
    selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    state.renderVersion,
    state.thread,
    state.threadGraph,
    state.scrolling,
    state.scrollVersion,
    state.scrollFrame,
    state.scrollRows,
  )
};

let toggleImageScale = match(scale) => {
  Image.Fit => { Image.Fill },
  Image.Fill => { Image.Fit },
};

let imageScaleName = match(scale) => {
  Image.Fit => { "fit" },
  Image.Fill => { "fill" },
};

let postsFor = match(feeds, view) => {
  (_, Timeline) => { feeds.timelinePosts },
  (_, OwnPosts) => { feeds.ownPosts },
};

let hideMedia = match(resource) => {
  Resource.Ready(Some(_)) => { Resource.Loading },
  _ => { resource },
};

let rec hidePostImages = match(posts) => {
  [] => { [] },
  [post, ..tail] => {
    let current: UiPost = post;
    [
      UiPost(
        current.post,
        hideMedia(current.image),
        hideMedia(current.avatar),
      ),
      ..hidePostImages(tail)
    ]
  },
};

let postsForState = (state: UiState) => {
  let posts = postsFor(state.feeds, state.view);
  if (state.scrolling) { hidePostImages(posts) } else { posts }
};

let titleFor = match(feeds, view) => {
  (_, Timeline) => { "timeline" },
  (_, OwnPosts) => { "@" ++ feeds.handle },
};
