-- Application event transitions and asynchronous feed pagination.

from "./feed-view.wm" import * as Feed;
from "../tui/tabs.wm" import * as TabBar;
from "./data.wm" import { pendingPosts };
from "./tabs.wm" import * as Tabs;
from "./graph.wm" import { buildPrefetchPlan, loadSelectedThread };
from "./model.wm" import *;
from "./likes.wm" import * as Likes;
from "./reaction-model.wm" import * as Reaction;
from "../proto/api.wm" import * as Api;
from "../proto/api.wm" import { FeedPage };
from "../proto/views.wm" import * as Views;
from "../proto/feed-tabs.wm" import * as SavedFeeds;
from "../proto/xrpc.wm" import { AppError, JavaScriptFailure, describeError };
from "../tui/command.wm" import * as Command;
from "../tui/event.wm" import * as Event;
from "../tui/image.wm" import * as Image;
from "../tui/geometry.wm" import * as Geometry;
from "../tui/timer.wm" import * as Timer;
from "../tui/scroll.wm" import * as Scroll;

-- Shared page operations are also used by semantic neighbor preloading.
let loadedState = Tabs.loadedState;
let failedPage = Tabs.failedPage;
let requestPage = (state: UiState) => { Tabs.requestPageFor(state, state.view) };
let loadNextPage = (state: UiState) => {
  let requestedView = state.view;
  let plan = buildPrefetchPlan(state);
  let feeds = modifyTab(plan.state.feeds, requestedView, (tab) => {
    .{ ..tab, loading = true, status = "" }
  });
  let pending = .{ ..plan.state, feeds = feeds, loading = true, status = "" };
  let task = requestPage(state) :> Task.map((page: FeedPage) => {
    let posts = pendingPosts(page.posts);
    (current: UiState) => { loadedState(current, requestedView, page, posts) }
  }) :> Task.recover((error) => {
    (current: UiState) => { failedPage(current, requestedView, describeError(error)) }
  });
  Command.SpawnMany(pending, [task, ..plan.tasks])
};
let hasMore = (state: UiState) => {
  let tab = tabValue(state.feeds, state.view);
  !tab.loaded || tab.cursor != None
};

-- Save navigation before leaving, and invalidate old animation timers on entry.
let switchTabState = (state: UiState, view) => {
  if (sameView(state.view, view)) { state } else {
    let feeds = modifyTab(state.feeds, state.view, (tab) => {
      .{ ..tab, selected = state.selected, scrollRows = state.scrollRows }
    });
    let target = tabValue(feeds, view);
    .{ ..state, view = view, feeds = feeds, selected = target.selected,
      scrollRows = target.scrollRows, loading = target.loading, status = target.status,
      scrolling = false, scrollVersion = state.scrollVersion + 1, scrollFrame = 0,
      thread = ThreadLoading(""), renderVersion = state.renderVersion + 1 }
  }
};
let activateTab = (state: UiState, view) => {
  let next = switchTabState(state, view);
  let tab = tabValue(next.feeds, view);
  if (!tab.loaded && !tab.loading) { loadNextPage(next) } else { loadSelectedThread(next) }
};
let tabIndex = activeTabIndex;
let adjacentTab = (state: UiState, delta) => {
  let count = List.length(state.feeds.tabs);
  let index = tabIndex(state) + delta;
  let wrapped = if (index < 0) { count - 1 } else { if (index >= count) { 0 } else { index } };
  match(List.at(state.feeds.tabs, wrapped)) {
    None => { Command.Continue(state) },
    Some(tab) => { activateTab(state, tab.view) },
  }
};

let moveDown = (state) => {
  let count = List.length(postsFor(state.feeds, state.view));
  let next = move(count, 1, state);
  if (!state.loading && hasMore(state) && next.selected >= count - 3) {
    loadNextPage(next)
  } else {
    if (next.selected == state.selected) {
      Command.Continue(next)
    } else {
      loadSelectedThread(next)
    }
  }
};

let scrollByRows = (state: UiState, rows) => {
  UiState(
    state.selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    state.renderVersion,
    state.thread,
    state.threadGraph,
    state.scrolling,
    state.scrollVersion,
    state.scrollFrame,
    state.scrollRows + rows,
  )
};

let updateStateBase = match(key, state) => {
  (Event.CtrlC, _) => { Command.Quit },
  (Event.Character("q"), _) => { Command.Quit },
  (Event.Character("L"), _) => { Likes.toggle(state) },
  (Event.Character("u"), _) => { adjacentTab(state, -1) },
  (Event.Character("i"), _) => { adjacentTab(state, 1) },
  (Event.Character("t"), _) => { activateTab(state, Timeline) },
  (Event.Character("m"), _) => { activateTab(state, OwnPosts) },
  (Event.Character("r"), _) => {
    if (state.loading || !hasMore(state)) { Command.Continue(state) } else { loadNextPage(state) }
  },
  (Event.Character("f"), _) => {
    Command.Continue(
      UiState(
        state.selected,
        state.view,
        toggleImageScale(state.imageScale),
        state.feeds,
        state.loading,
        state.status,
        state.renderVersion + 1,
        state.thread,
        state.threadGraph,
        state.scrolling,
        state.scrollVersion,
        state.scrollFrame,
        state.scrollRows,
      ),
    )
  },
  (Event.Up, _) => {
    let next = move(List.length(postsFor(state.feeds, state.view)), -1, state);
    if (next.selected == state.selected) {
      Command.Continue(next)
    } else {
      loadSelectedThread(next)
    }
  },
  (Event.Character("k"), _) => {
    let next = move(List.length(postsFor(state.feeds, state.view)), -1, state);
    if (next.selected == state.selected) {
      Command.Continue(next)
    } else {
      loadSelectedThread(next)
    }
  },
  (Event.WheelUp, _) => {
    Command.Continue(
      scrollByRows(
        move(List.length(postsFor(state.feeds, state.view)), -1, state),
        -3,
      ),
    )
  },
  (Event.Down, _) => { moveDown(state) },
  (Event.Character("j"), _) => { moveDown(state) },
  (Event.WheelDown, _) => {
    Command.Continue(
      scrollByRows(
        move(List.length(postsFor(state.feeds, state.view)), 1, state),
        3,
      ),
    )
  },
  (Event.PageUp, _) => {
    let next = move(List.length(postsFor(state.feeds, state.view)), -3, state);
    if (next.selected == state.selected) {
      Command.Continue(next)
    } else {
      loadSelectedThread(next)
    }
  },
  (Event.PageDown, _) => {
    let count = List.length(postsFor(state.feeds, state.view));
    let next = move(count, 3, state);
    if (!state.loading && hasMore(state) && next.selected >= count - 3) {
      loadNextPage(next)
    } else {
      if (next.selected == state.selected) {
        Command.Continue(next)
      } else {
        loadSelectedThread(next)
      }
    }
  },
  (Event.Home, _) => {
    loadSelectedThread(
      UiState(
        0,
        state.view,
        state.imageScale,
        state.feeds,
        state.loading,
        state.status,
        state.renderVersion,
        state.thread,
        state.threadGraph,
        state.scrolling,
        state.scrollVersion,
        state.scrollFrame,
        state.scrollRows,
      ),
    )
  },
  (Event.End, _) => {
    loadSelectedThread(
      UiState(
        Geometry.nonNegative(List.length(postsFor(state.feeds, state.view)) - 1),
        state.view,
        state.imageScale,
        state.feeds,
        state.loading,
        state.status,
        state.renderVersion,
        state.thread,
        state.threadGraph,
        state.scrolling,
        state.scrollVersion,
        state.scrollFrame,
        state.scrollRows,
      ),
    )
  },
  _ => { Command.Continue(state) },
};

let scrollKey = match(key) => {
  Event.Up => { true },
  Event.Down => { true },
  Event.Home => { true },
  Event.End => { true },
  Event.PageUp => { true },
  Event.PageDown => { true },
  Event.WheelUp => { true },
  Event.WheelDown => { true },
  Event.Character("j") => { true },
  Event.Character("k") => { true },
  Event.Character("u") => { true },
  Event.Character("i") => { true },
  Event.Character("t") => { true },
  Event.Character("m") => { true },
  _ => { false },
};

let scrollingState = (state: UiState, version, scrolling) => {
  UiState(
    state.selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    state.renderVersion,
    state.thread,
    state.threadGraph,
    scrolling,
    version,
    0,
    state.scrollRows,
  )
};

let scrollFrameState = (state: UiState, version, frame, scrolling) => {
  UiState(
    state.selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    state.renderVersion,
    state.thread,
    state.threadGraph,
    scrolling,
    version,
    frame,
    state.scrollRows,
  )
};

let animationFrame = (version, frame, milliseconds, finalFrame) => {
  Timer.delay(milliseconds)
    :> Task.mapErr(JavaScriptFailure)
    :> Task.map((_) => {
      (current: UiState) => {
        if (
          current.scrollVersion == version &&
          current.scrollFrame < frame
        ) {
          scrollFrameState(
            current,
            version,
            frame,
            !finalFrame,
          )
        } else {
          current
        }
      }
    })
};

let animationFrames = (version) => {
  let count = List.length(Scroll.frameTimes);
  let rec frames = match(times, index) => {
    ([], _) => { [] },
    ([milliseconds, ..tail], _) => {
      [animationFrame(version, index, milliseconds, index == count), ..frames(tail, index + 1)]
    },
  };
  frames(Scroll.frameTimes, 1)
};

let beginScroll = match(step) => {
  Command.Quit => { Command.Quit },
  Command.Continue(state) => {
    let version = state.scrollVersion + 1;
    Command.SpawnMany(
      scrollingState(state, version, true),
      animationFrames(version),
    )
  },
  Command.Spawn(state, task) => {
    let version = state.scrollVersion + 1;
    Command.SpawnMany(
      scrollingState(state, version, true),
      [task, ..animationFrames(version)],
    )
  },
  Command.SpawnMany(state, tasks) => {
    let version = state.scrollVersion + 1;
    Command.SpawnMany(
      scrollingState(state, version, true),
      List.append(animationFrames(version), tasks),
    )
  },
  Command.Await(state, task) => { Command.Await(state, task) },
};

let updateState = (key, state) => {
  let updated = updateStateBase(key, state);
  let scrolling = if (scrollKey(key)) { beginScroll(updated) } else { updated };
  scrolling
};

-- Hit testing uses the painted offsets, including partially visible cards/tabs.
let rec hitExtent = match(extents, position, overlap, index) => {
  ([], _, _, _) => { None },
  ([extent], _, _, _) => {
    if (position >= 0 && position < extent) { Some(index) } else { None }
  },
  ([extent, ..tail], _, _, _) => {
    let stride = Geometry.nonNegative(extent - overlap);
    if (position >= 0 && position < stride) { Some(index) } else {
      hitExtent(tail, position - stride, overlap, index + 1)
    }
  },
};

let updateStateAt = (key, state: UiState, painted: RenderModel) => {
  match(key) {
    Event.Click(x, y) => {
      let size = painted.size;
      if (x < 0 || x >= size.width || y < 0 || y >= size.height) {
        Command.Continue(state)
      } else {
        if (y == 0 && size.width >= 12) {
          if (x < 4) { adjacentTab(state, -1) } else {
            if (x >= size.width - 4) { adjacentTab(state, 1) } else {
              let labels = state.feeds.tabs :> List.map((tab) => { tab.title });
              let strip = TabBar.track(size.width, labels);
              let hit = hitExtent(strip.extents, x - 4 + painted.tabScroll.position, 0, 0);
              match(hit) {
                None => { Command.Continue(state) },
                Some(index) => {
                  match(List.at(state.feeds.tabs, index)) {
                    Some(tab) => { activateTab(state, tab.view) },
                    None => { Command.Continue(state) },
                  }
                },
              }
            }
          }
        } else {
          let split = panes(contentBody(size), size);
          let area = split.feed;
          if (!sameView(state.view, painted.state.view) || x < area.x || x >= area.x + area.width || y < area.y || y >= area.y + area.height) {
            Command.Continue(state)
          } else {
            let heights = Feed.cardHeights(postsForState(painted.state), feedLayout(area.width, size, painted.state));
            match(hitExtent(heights, y - area.y + painted.scrollOffset, 1, 0)) {
              None => { Command.Continue(state) },
              Some(index) => {
                if (index == state.selected) { Command.Continue(state) } else {
                  loadSelectedThread(.{ ..state, selected = index })
                }
              },
            }
          }
        }
      }
    },
    _ => { updateState(key, state) },
  }
};
