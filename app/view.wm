-- Terminal layout and content rendering for the atview application.

from "./model.wm" import *;
from "./feed-view.wm" import *;
from "./thread-view.wm" import *;
from "../proto/api.wm" import { FeedPost };
from "../proto/views.wm" import * as Views;
from "../tui/ansi.wm" import * as Ansi;
from "../tui/draw.wm" import * as Draw;
from "../tui/geometry.wm" import * as Geometry;
from "../tui/kitty.wm" import * as Kitty;
from "../tui/image-host.wm" import * as ImageHost;
from "../tui/tabs.wm" import * as TabBar;
from "../tui/terminal-cap.wm" import * as Cap;
from "../tui/scroll.wm" import * as Scroll;

let renderTabsAt = (state: UiState, size: Geometry.Size, offset) => {
  TabBar.renderAt(Geometry.rect(0, 0, size.width, 1),
    state.feeds.tabs :> List.map((tab) => { tab.title }), activeTabIndex(state), offset)
};
let renderTabs = (state: UiState, size: Geometry.Size) => {
  TabBar.render(Geometry.rect(0, 0, size.width, 1),
    state.feeds.tabs :> List.map((tab) => { tab.title }), activeTabIndex(state))
};

let renderFooter = (state: UiState, size: Geometry.Size) => {
  let feeds = state.feeds;
  let posts = postsFor(feeds, state.view);
  let (_, footer) = Geometry.reserveBottom(Geometry.screen(size), 1);
  let activity = if (state.loading) {
    "   loading…"
  } else {
    if (footerStatus(state) == "") { "" } else { "   " ++ footerStatus(state) }
  };
  let graph = graphCounts(state.threadGraph);
  let background = if (graph.pending > 0) {
    "   bg " ++ Text.of(graph.ready) ++
      "+" ++ Text.of(graph.pending)
  } else {
    ""
  };
  let help = if (phoneAspect(Geometry.screen(size), size)) {
    "   j/k move   u/i tabs   L ♥   r retry   q quit "
  } else {
    "   u/i tabs   L like   t following   m my posts   f fit/fill   r retry   j/k move   q quit "
  };
  Draw.fill(footer, " ", Draw.status) ++
    Draw.text(
      footer,
      " " ++ titleFor(feeds, state.view) ++ "   " ++
        Text.of(if (List.length(posts) == 0) { 0 } else { state.selected + 1 }) ++ "/" ++ Text.of(List.length(posts)) ++
        activity ++ background ++ help,
      Draw.status,
    )
};

let rec renderBorderAt = match(area, posts, request) => {
  (_, [], _) => { "" },
  (_, _, _) => {
    match(posts) {
      [] => { "" },
      [item, ..tail] => {
        let height = cardHeight(
          area.width,
          request.layout.size,
          request.layout.scale,
          item,
        );
        if (area.height < 2) {
          ""
        } else {
          let visibleHeight = Geometry.clamp(2, height, area.height);
          if (request.cursor.index == request.target) {
            let borderArea = Geometry.rect(
              area.x,
              area.y,
              area.width,
              visibleHeight,
            );
            let joinedBottom = match(tail) {
              [] => { false },
              _ => { area.height > visibleHeight },
            };
            if (request.standalone) {
              Draw.box(borderArea, "", request.active)
            } else {
              Draw.timelineBox(
                borderArea,
                request.active,
                area.y > 1,
                joinedBottom,
              )
            }
          } else {
            renderBorderAt(
              Geometry.rect(
                area.x,
                area.y + visibleHeight - 1,
                area.width,
                area.height - visibleHeight + 1,
              ),
              tail,
              BorderRender(
                CardCursor(
                  request.cursor.selected,
                  request.cursor.index + 1,
                ),
                request.layout,
                request.target,
                request.active,
                request.standalone,
              ),
            )
          }
        }
      },
    }
  },
};

let renderViewportAt = (
  state: UiState,
  size: Geometry.Size,
  start,
  inset,
  tabOffset,
) => {
  let posts = postsForState(state);
  let body = contentBody(size);
  let split = panes(body, size);
  let feedArea = Geometry.rect(
    split.feed.x,
    split.feed.y - inset,
    split.feed.width,
    split.feed.height + inset,
  );
  let visible = List.drop(posts, start);
  let cursor = CardCursor(state.selected, start);
  let layout = FeedLayout(split.feed.width, size, state.imageScale);
  Ansi.beginSynchronizedUpdate ++ Draw.beginFrame ++ ImageHost.deleteAll() ++
    renderCardsVisible(feedArea, visible, start, layout, !state.scrolling || Cap.renderer == Cap.SixelRenderer) ++
    renderBorderAt(
      feedArea,
      visible,
      BorderRender(cursor, layout, state.selected, true, true),
    ) ++
    (if (split.thread.width > 0) { renderThreadPane(split.thread, state, size) } else { "" }) ++
    renderFooter(state, size) ++ renderTabsAt(state, size, tabOffset) ++
    Draw.endFrame ++ Ansi.endSynchronizedUpdate
};

let renderViewport = (state: UiState, size: Geometry.Size, start, inset) => {
  let labels = state.feeds.tabs :> List.map((tab) => { tab.title });
  let strip = TabBar.track(size.width, labels);
  renderViewportAt(state, size, start, inset, Scroll.reveal(strip, activeTabIndex(state), 0))
};

let renderFull = (state: UiState, size: Geometry.Size) => {
  let posts = postsForState(state);
  let body = contentBody(size);
  let split = panes(body, size);
  let layout = FeedLayout(split.feed.width, size, state.imageScale);
  let strip = Scroll.Strip(cardHeights(posts, layout), split.feed.height, 1);
  let viewport = Scroll.locateAxis(strip, Scroll.reveal(strip, state.selected, 0));
  renderViewport(state, size, viewport.start, viewport.inset)
};

let renderFeedMedia = (state: UiState, size: Geometry.Size, start, inset, showImages) => {
  let posts = postsFor(state.feeds, state.view);
  let body = contentBody(size);
  let split = panes(body, size);
  let visible = List.drop(posts, start);
  renderMediaCards(
    Geometry.rect(split.feed.x, split.feed.y - inset, split.feed.width, split.feed.height + inset),
    visible,
    start,
    FeedLayout(split.feed.width, size, state.imageScale),
    showImages,
  )
};

let renderSelectionOutline = (
  state: UiState,
  size: Geometry.Size,
  start,
  inset,
  target,
  active,
  standalone,
) => {
  let posts = postsForState(state);
  let body = contentBody(size);
  let split = panes(body, size);
  let visible = List.drop(posts, start);
  let cursor = CardCursor(state.selected, start);
  let layout = FeedLayout(split.feed.width, size, state.imageScale);
  renderBorderAt(
    Geometry.rect(split.feed.x, split.feed.y - inset, split.feed.width, split.feed.height + inset),
    visible,
    BorderRender(cursor, layout, target, active, standalone),
  )
};

let renderThreadRegion = (state: UiState, size: Geometry.Size) => {
  let body = contentBody(size);
  let split = panes(body, size);
  if (split.thread.width <= 0) {
    ""
  } else {
    ImageHost.deleteImage(1) ++
      deleteThreadImages(2000, size.height + 1) ++
      Draw.fill(split.thread, " ", Draw.plain) ++
      renderThreadPane(split.thread, state, size)
  }
};

let renderReactions = (state: UiState, size: Geometry.Size, start, inset) => {
  let split = panes(contentBody(size), size);
  let area = Geometry.rect(split.feed.x, split.feed.y - inset, split.feed.width, split.feed.height + inset);
  renderMetrics(area, List.drop(postsForState(state), start), FeedLayout(split.feed.width, size, state.imageScale)) ++
    (if (split.thread.width > 0) { renderThreadReactions(split.thread, state, size) } else { "" })
};
