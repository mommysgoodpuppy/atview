-- Reactive render dependencies and incremental terminal surface updates.

from "./model.wm" import *;
from "./feed-view.wm" import { cardHeights };
from "./view.wm" import *;
from "../tui/ansi.wm" import * as Ansi;
from "../tui/draw.wm" import * as Draw;
from "../tui/geometry.wm" import * as Geometry;
from "../tui/kitty.wm" import * as Kitty;
from "../tui/reactive.wm" import * as Reactive;
from "../tui/scroll.wm" import * as Scroll;
from "../tui/surface.wm" import * as Surface;
from "../tui/image.wm" import * as Image;
from "../tui/tabs.wm" import * as TabBar;


let threadKey = match(thread) => {
  ThreadLoading(uri) => { "loading:" ++ uri },
  ThreadReady(uri, _) => { "ready:" ++ uri },
  ThreadFailed(uri, message) => { "failed:" ++ uri ++ ":" ++ message },
};

let feedRegion = (model: RenderModel) => {
  FeedRegion(
    model.state.renderVersion,
    model.state.scrolling,
    model.start,
    model.scrollOffset,
    model.size,
  )
};

let selectionRegion = (model: RenderModel) => {
  SelectionRegion(model.state.selected, model.start)
};

let mediaRegion = (model: RenderModel) => {
  MediaRegion(model.state.scrolling, model.start, model.size)
};

let threadRegion = (model: RenderModel) => {
  ThreadRegion(
    model.state.selected,
    model.state.scrolling,
    model.state.renderVersion,
    model.state.imageScale,
    threadKey(model.state.thread),
    model.size,
  )
};

let footerRegion = (model: RenderModel) => {
  let graph = graphCounts(model.state.threadGraph);
  FooterRegion(
    model.state.selected,
    List.length(postsFor(model.state.feeds, model.state.view)),
    model.state.view,
    model.state.loading,
    footerStatus(model.state),
    graph.ready,
    graph.pending,
    model.size,
  )
};

let sameSize = (left: Geometry.Size, right: Geometry.Size) => {
  left.width <= right.width && left.width >= right.width &&
    left.height <= right.height && left.height >= right.height &&
    left.cellWidth <= right.cellWidth && left.cellWidth >= right.cellWidth &&
    left.cellHeight <= right.cellHeight && left.cellHeight >= right.cellHeight
};

let sameScale = match(left, right) => {
  (Image.Fit, Image.Fit) => { true },
  (Image.Fill, Image.Fill) => { true },
  _ => { false },
};

let sameNumber = (left: Number, right: Number) => {
  left <= right && left >= right
};

let sameText = (left: String, right: String) => {
  left == right
};

let sameBool = match(left, right) => {
  (true, true) => { true },
  (false, false) => { true },
  _ => { false },
};

let sameFeedRegion = (left: FeedRegion, right: FeedRegion) => {
  sameNumber(left.renderVersion, right.renderVersion) &&
    sameBool(left.scrolling, right.scrolling) &&
    sameNumber(left.start, right.start) &&
    sameNumber(left.scrollOffset, right.scrollOffset) &&
    sameSize(left.size, right.size)
};

let sameSelectionRegion = (left: SelectionRegion, right: SelectionRegion) => {
  sameNumber(left.selected, right.selected) &&
    sameNumber(left.start, right.start)
};

let sameMediaRegion = (left: MediaRegion, right: MediaRegion) => {
  sameBool(left.scrolling, right.scrolling) &&
    sameNumber(left.start, right.start) &&
    sameSize(left.size, right.size)
};

let sameThreadRegion = (left: ThreadRegion, right: ThreadRegion) => {
  sameNumber(left.selected, right.selected) &&
    sameBool(left.scrolling, right.scrolling) &&
    sameNumber(left.renderVersion, right.renderVersion) &&
    sameScale(left.imageScale, right.imageScale) &&
    sameText(left.threadKey, right.threadKey) &&
    sameSize(left.size, right.size)
};

let sameFooterRegion = (left: FooterRegion, right: FooterRegion) => {
  sameNumber(left.selected, right.selected) &&
    sameNumber(left.count, right.count) &&
    sameView(left.view, right.view) &&
    sameBool(left.loading, right.loading) &&
    sameText(left.status, right.status) &&
    sameNumber(left.graphReady, right.graphReady) &&
    sameNumber(left.graphPending, right.graphPending) &&
    sameSize(left.size, right.size)
};

let sameRenderDependency = match(left, right) => {
  (SelectionSurface, SelectionSurface) => { true },
  (MediaSurface, MediaSurface) => { true },
  (ThreadSurface, ThreadSurface) => { true },
  (FooterSurface, FooterSurface) => { true },
  (TabsSurface, TabsSurface) => { true },
  (ReactionSurface, ReactionSurface) => { true },
  _ => { false },
};

let selectionSignal = Reactive.signal(
  SelectionSurface,
  (model: RenderModel) => { model },
);

let mediaSignal = Reactive.signal(
  MediaSurface,
  (model: RenderModel) => { model },
);

let threadSignal = Reactive.signal(
  ThreadSurface,
  (model: RenderModel) => { model },
);

let footerSignal = Reactive.signal(
  FooterSurface,
  (model: RenderModel) => { model },
);

let tabsSignal = Reactive.signal(TabsSurface, (model: RenderModel) => { model });
let tabsEffect = Reactive.effect(
  "tabs",
  Reactive.read(tabsSignal) :> Reactive.map((model) => {
    Reactive.commands([Surface.Raw(renderTabsAt(model.state, model.size, model.tabScroll.position))])
  }),
);

let reactionSignal = Reactive.signal(ReactionSurface, (model: RenderModel) => { model });
let reactionEffect = Reactive.effect("reactions",
  Reactive.read(reactionSignal) :> Reactive.map((model) => {
    Reactive.commands([Surface.Raw(renderReactions(model.state, model.size, model.start, model.scrollInset))])
  }),
);

let selectionEffect = Reactive.effect(
  "selection",
  Reactive.read(selectionSignal) :> Reactive.map((model) => {
    let state = model.state;
    let selected = state.selected;
    Reactive.emit(
      [
        Surface.Raw(
          renderSelectionOutline(
            state,
            model.size,
            model.start,
            model.scrollInset,
            selected,
            true,
            true,
          ),
        )
      ],
      [
        Surface.Raw(
          renderSelectionOutline(
            state,
            model.size,
            model.start,
            model.scrollInset,
            selected,
            false,
            false,
          ),
        )
      ],
    )
  }),
);

let mediaEffect = Reactive.effect(
  "media",
  Reactive.read(mediaSignal) :> Reactive.map((model) => {
    Reactive.commands(
      [
        Surface.Raw(
          renderFeedMedia(
            model.state,
            model.size,
            model.start,
            model.scrollInset,
            !model.state.scrolling,
          ),
        )
      ],
    )
  }),
);

let threadEffect = Reactive.effect(
  "thread",
  Reactive.read(threadSignal) :> Reactive.map((model) => {
    Reactive.commands(
      [Surface.Raw(renderThreadRegion(model.state, model.size))],
    )
  }),
);

let footerEffect = Reactive.effect(
  "footer",
  Reactive.read(footerSignal) :> Reactive.map((model) => {
    Reactive.commands(
      [Surface.Raw(renderFooter(model.state, model.size))],
    )
  }),
);

let renderEffects = [selectionEffect, mediaEffect, threadEffect, footerEffect, tabsEffect, reactionEffect];

let changedDependencies = (previous: RenderModel, next: RenderModel) => {
  let tabsChanged = !sameView(previous.state.view, next.state.view) ||
    previous.tabScroll.position != next.tabScroll.position ||
    !sameSize(previous.size, next.size) ||
    (previous.state.feeds.tabs :> List.map((tab) => { tab.title })) !=
      (next.state.feeds.tabs :> List.map((tab) => { tab.title }));
  let selectionChanged = !sameSelectionRegion(
    selectionRegion(previous),
    selectionRegion(next),
  );
  let mediaChanged = !sameMediaRegion(
    mediaRegion(previous),
    mediaRegion(next),
  );
  let threadChanged = !sameThreadRegion(
    threadRegion(previous),
    threadRegion(next),
  );
  let footerChanged = !sameFooterRegion(
    footerRegion(previous),
    footerRegion(next),
  );
  let selectionKeys = if (selectionChanged) {
    [SelectionSurface]
  } else {
    []
  };
  let mediaKeys = if (mediaChanged) {
    [MediaSurface]
  } else {
    []
  };
  let threadKeys = if (threadChanged) {
    [ThreadSurface]
  } else {
    []
  };
  let footerKeys = if (footerChanged) {
    [FooterSurface]
  } else {
    []
  };
  let tabsKeys = if (tabsChanged) { [TabsSurface] } else { [] };
  let reactionKeys = if (previous.state.feeds.reactionVersion != next.state.feeds.reactionVersion) { [ReactionSurface] } else { [] };
  List.append(reactionKeys, List.append(tabsKeys, List.append(selectionKeys,
    List.append(mediaKeys, List.append(threadKeys, footerKeys)))))
};

let synchronized = match(commands) => {
  [] => { [] },
  _ => {
    List.append(
      [Surface.Raw(Ansi.beginSynchronizedUpdate)],
      List.append(
        commands,
        [
          Surface.Raw(Draw.endFrame),
          Surface.Raw(Ansi.endSynchronizedUpdate)
        ],
      ),
    )
  },
};

-- Input starts an animation clock before layout knows whether the viewport
-- needs to move. Only actual viewport motion should hide media or invalidate
-- the retained feed surface.
let paintState = (state: UiState, moving) => {
  UiState(
    state.selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    state.renderVersion,
    state.thread,
    state.threadGraph,
    moving,
    state.scrollVersion,
    state.scrollFrame,
    state.scrollRows,
  )
};

let project = (previous, state: UiState, size: Geometry.Size) => {
  let posts = postsFor(state.feeds, state.view);
  let body = contentBody(size);
  let split = panes(body, size);
  let layout = FeedLayout(split.feed.width, size, state.imageScale);
  let heights = cardHeights(posts, layout);
  let feedStrip = Scroll.Strip(heights, split.feed.height, 1);
  let labels = state.feeds.tabs :> List.map((tab) => { tab.title });
  let tabStrip = TabBar.track(size.width, labels);
  let selectedTarget = Scroll.reveal(feedStrip, state.selected, 0);
  let advanceFrame = match(previous) {
    None => { true },
    Some(graph) => {
      state.scrollVersion != graph.model.state.scrollVersion || state.scrollFrame != graph.model.state.scrollFrame
    },
  };
  let targetOffset = match(previous) {
    None => { selectedTarget },
    Some(graph) => {
      let old = graph.model;
      let rowDelta = state.scrollRows - old.state.scrollRows;
      let geometryChanged = if (state.renderVersion != old.state.renderVersion) {
        cardHeights(postsFor(old.state.feeds, old.state.view), layout) != heights
      } else { false };
      if (!sameView(state.view, old.state.view)) { selectedTarget } else {
        if (!sameScale(state.imageScale, old.state.imageScale) || !sameSize(size, old.size) || geometryChanged) {
          Scroll.reveal(feedStrip, state.selected, old.scrollTarget)
        } else {
          if (rowDelta != 0) { Scroll.limit(feedStrip, old.scrollTarget + rowDelta) } else {
            if (state.selected != old.state.selected || state.scrollVersion != old.state.scrollVersion) {
              Scroll.reveal(feedStrip, state.selected, old.scrollTarget)
            } else { Scroll.limit(feedStrip, old.scrollTarget) }
          }
        }
      }
    },
  };
  let currentOffset = match(previous) {
    None => { targetOffset },
    Some(graph) => {
      if (sameView(state.view, graph.model.state.view)) { Scroll.limit(feedStrip, graph.model.scrollOffset) } else { targetOffset }
    },
  };
  let feedMotion = Scroll.frame(Scroll.Motion(currentOffset, targetOffset), state.scrolling, advanceFrame);
  let nextOffset = feedMotion.position;
  let tabMotion = match(previous) {
    None => {
      let target = Scroll.reveal(tabStrip, activeTabIndex(state), 0);
      Scroll.Motion(target, target)
    },
    Some(graph) => {
      let next = Scroll.retarget(tabStrip, graph.model.tabScroll, activeTabIndex(state));
      Scroll.frame(next, state.scrolling && sameSize(size, graph.model.size), advanceFrame)
    },
  };
  let viewport = Scroll.locateAxis(feedStrip, nextOffset);
  let painted = paintState(
    state,
    state.scrolling && (nextOffset != currentOffset || nextOffset != targetOffset),
  );
  RenderModel(
    painted,
    size,
    viewport.start,
    viewport.inset,
    nextOffset,
    targetOffset,
    tabMotion,
  )
};

let render = (previous, state: UiState, size: Geometry.Size) => {
  let nextModel = project(previous, state, size);
  let painted = nextModel.state;
  let viewport = Scroll.Viewport(nextModel.start, nextModel.scrollInset);
  let tabMotion = nextModel.tabScroll;
  match(previous) {
    None => {
      let mounted = Reactive.mount(nextModel, renderEffects);
      Surface.frame(
        mounted.graph,
        size,
        [Surface.Raw(renderViewportAt(painted, size, viewport.start, viewport.inset, tabMotion.position))],
      )
    },
    Some(graph) => {
      if (!sameFeedRegion(feedRegion(graph.model), feedRegion(nextModel))) {
        let mounted = Reactive.mount(nextModel, renderEffects);
        Surface.frame(
          mounted.graph,
          size,
          [Surface.Raw(renderViewportAt(painted, size, viewport.start, viewport.inset, tabMotion.position))],
        )
      } else {
        let flushed = Reactive.flush(
          graph,
          Reactive.Transition(
            nextModel,
            changedDependencies(graph.model, nextModel),
          ),
          sameRenderDependency,
        );
        Surface.frame(flushed.graph, size, synchronized(flushed.output))
      }
    },
  }
};
