-- Feed-card measurement, wrapping, placement, and drawing.

from "./model.wm" import *;
from "../proto/api.wm" import { FeedPost };
from "../proto/views.wm" import * as Views;
from "../tui/ansi.wm" import * as Ansi;
from "../tui/draw.wm" import * as Draw;
from "../tui/element.wm" import * as Ui;
from "../tui/geometry.wm" import * as Geometry;
from "../tui/kitty.wm" import * as Kitty;
from "../tui/image-host.wm" import * as ImageHost;
from "../tui/image.wm" import * as Image;
from "../tui/resource.wm" import * as Resource;

let wrapOnce = (text, width) => {
  let size = text :> .length :> Result.getOr(0);
  let newline = text :> .indexOf("\n") :> Result.getOr(-1);
  if (newline >= 0 && (width <= 0 || newline <= width)) {
    (
      text :> .slice(0, newline) :> Result.getOr(""),
      text :> .slice(newline + 1) :> Result.getOr(""),
    )
  } else {
    if (width <= 0 || size <= width) {
      (text, "")
    } else {
      let candidate = text :> .slice(0, width + 1) :> Result.getOr(text);
      let space = candidate :> .lastIndexOf(" ") :> Result.getOr(-1);
      let boundary = if (space <= 0) { width } else { space };
      let next = if (space <= 0) { boundary } else { boundary + 1 };
      (
        text :> .slice(0, boundary) :> Result.getOr(""),
        text :> .slice(next) :> Result.getOr(""),
      )
    }
  }
};

let rec wrapLines = match(text, width, remaining) => {
  (_, _, 0) => { [] },
  ("", _, _) => { [] },
  (_, _, _) => {
    let (line, rest) = wrapOnce(text, width);
    let next = if (rest == text) { "" } else { rest };
    [line, ..wrapLines(next, width, remaining - 1)]
  },
};

-- The text length bounds the number of rows even at a one-column width.
let postLines = (text, width) => {
  wrapLines(text, width, (text :> .length :> Result.getOr(0)) + 1)
};

let rec indentation = (depth) => {
  if (depth <= 0) { "" } else { "  " ++ indentation(depth - 1) }
};

let metrics = (post) => {
  heart(post.viewerLike) ++ countText(post.replyCount) ++ " replies   " ++
    countText(post.repostCount) ++ " reposts   " ++
    countText(post.likeCount) ++ " likes"
};

let pendingImageRows = (width, maximum, size, scale, source: Views.PostImage) => {
  match(scale, source.aspectRatio) {
    (Image.Fit, Some(ratio)) => {
      Image.fitRows(width, maximum, size, Image.Image("", "", ratio.width, ratio.height, None))
    },
    -- Without metadata, use a small explicit placeholder rather than a large
    -- blank image frame. Loading may still reflow posts with unknown ratios.
    (Image.Fit, None) => { Geometry.clamp(0, maximum, 2) },
    (Image.Fill, _) => { maximum },
  }
};

let imageRows = (width, maximum, size, scale, item: UiPost) => {
  if (maximum <= 0 || width <= 0) { 0 } else {
    match(item.post.image, item.image) {
      (None, _) => { 0 },
      (_, Resource.Ready(Some(image))) => {
        match(scale) {
          Image.Fit => { Image.fitRows(width, maximum, size, image) },
          Image.Fill => { maximum },
        }
      },
      (Some(source), Resource.Pending) => { pendingImageRows(width, maximum, size, scale, source) },
      (Some(source), Resource.Loading) => { pendingImageRows(width, maximum, size, scale, source) },
      (_, Resource.Ready(None)) => { 0 },
      (_, Resource.Failed(_)) => { 0 },
    }
  }
};

let avatarColumns = (rows, size, resource) => {
  match(resource) {
    Resource.Pending => { Kitty.squareColumns(rows, size) },
    Resource.Loading => { Kitty.squareColumns(rows, size) },
    Resource.Failed(_) => { 0 },
    Resource.Ready(None) => { 0 },
    Resource.Ready(Some(_)) => { Kitty.squareColumns(rows, size) },
  }
};

let baseCardHeight = (width, size, item) => {
  let avatarColumns = avatarColumns(2, size, item.avatar);
  let textWidth = Geometry.nonNegative(
    width - 2 - avatarColumns - (if (avatarColumns > 0) { 1 } else { 0 }),
  );
  let lines = postLines(item.post.text, textWidth);
  4 + List.length(lines)
};

let maximumCardHeight = (size: Geometry.Size) => {
  let body = contentBody(size);
  if (phoneAspect(body, size)) {
    Geometry.clamp(12, 28, Geometry.percentOf(body.height, 85))
  } else {
    Geometry.clamp(8, 14, Geometry.percentOf(body.height, 60))
  }
};

let cardHeight = (width, size, scale, item) => {
  let base = baseCardHeight(width, size, item);
  let avatarColumns = avatarColumns(2, size, item.avatar);
  let mediaWidth = Geometry.nonNegative(
    width - 2 - avatarColumns - (if (avatarColumns > 0) { 1 } else { 0 }),
  );
  let maximumImageRows = Geometry.nonNegative(maximumCardHeight(size) - base);
  base + imageRows(mediaWidth, maximumImageRows, size, scale, item)
};

let rec cardHeights = match(posts, layout) => {
  ([], _) => { [] },
  ([item, ..tail], _) => {
    [
      cardHeight(layout.width, layout.size, layout.scale, item),
      ..cardHeights(tail, layout),
    ]
  },
};

let cardText = (area, row, x, width, value, style) => {
  Ui.showIf(
    row < area.height - 1,
    Ui.text(
      Geometry.rect(x, area.y + row, width, 1),
      value,
      style,
    ),
  )
};

let cardMetrics = (area, item, size, scale) => {
  let columns = avatarColumns(2, size, item.avatar);
  let gap = if (columns > 0) { 1 } else { 0 };
  let width = Geometry.nonNegative(area.width - 2 - columns - gap);
  let row = cardHeight(area.width, size, scale, item) - 2;
  let rect = Geometry.rect(area.x + 1 + columns + gap, area.y + row, width, 1);
  Ui.showIf(row < area.height - 1 && rect.y >= 1,
    Ui.fragment([Ui.fill(rect, " ", Draw.plain), Ui.text(rect, metrics(item.post) ++ "   " ++ item.post.createdAt, Draw.muted)]))
};

let card = (area, item, size, scale, joinedBottom, avatarId, showImages) => {
  let innerWidth = Geometry.nonNegative(area.width - 2);
  let avatarRows = if (cardHeight(area.width, size, scale, item) > 3) { 2 } else { 0 };
  let avatarColumns = avatarColumns(avatarRows, size, item.avatar);
  let textX = area.x + 1 + avatarColumns +
    (if (avatarColumns > 0) { 1 } else { 0 });
  let textWidth = Geometry.nonNegative(
    innerWidth - avatarColumns - (if (avatarColumns > 0) { 1 } else { 0 }),
  );
  let lines = postLines(item.post.text, textWidth);
  let mediaRow = 2 + List.length(lines);
  let metricsRow = cardHeight(area.width, size, scale, item) - 2;
  let rows = imageRows(
    textWidth,
    Geometry.nonNegative(maximumCardHeight(size) - baseCardHeight(area.width, size, item)),
    size,
    scale,
    item,
  );
  Ui.fragment([
    Ui.timelineBox(area, false, area.y > 1, joinedBottom),
    cardText(
      area,
      1,
      textX,
      textWidth,
      item.post.authorName ++ "  @" ++ item.post.authorHandle,
      Draw.plain,
    ),
    Ui.lines(
      Geometry.rect(textX, area.y + 2, textWidth, Geometry.nonNegative(area.height - 3)),
      lines,
      Draw.plain,
    ),
    cardMetrics(area, item, size, scale),
    Ui.suspense(
      if (showImages) { item.avatar } else { hideMedia(item.avatar) },
      Ui.fill(
        Geometry.rect(area.x + 1, area.y + 1, avatarColumns, avatarRows),
        "░",
        Draw.muted,
      ),
      (_) => { Ui.empty },
      (avatar) => {
        Ui.optional(avatar, (image) => {
          Ui.imageViewport(
            avatarId,
            Geometry.rect(area.x + 1, area.y + 1, avatarColumns, avatarRows),
            contentBody(size),
            Image.Fill,
            image,
          )
        })
      },
    ),
    Ui.suspense(
      if (showImages) { item.image } else { hideMedia(item.image) },
      Ui.textViewport(Geometry.rect(textX, area.y + mediaRow, textWidth, rows), contentBody(size), "loading image…", "", Draw.muted),
      (_) => { Ui.empty },
      (image) => {
        Ui.optional(image, (value) => {
          Ui.imageViewport(
            99000 + avatarId,
            Geometry.rect(textX, area.y + mediaRow, textWidth, rows),
            contentBody(size),
            scale,
            value,
          )
        })
      },
    ),
  ])
};

let cardMedia = (area, item, size, scale, imageId, showImages) => {
  let innerWidth = Geometry.nonNegative(area.width - 2);
  let avatarRows = if (cardHeight(area.width, size, scale, item) > 3) { 2 } else { 0 };
  let avatarColumns = avatarColumns(avatarRows, size, item.avatar);
  let textX = area.x + 1 + avatarColumns +
    (if (avatarColumns > 0) { 1 } else { 0 });
  let textWidth = Geometry.nonNegative(
    innerWidth - avatarColumns - (if (avatarColumns > 0) { 1 } else { 0 }),
  );
  let lines = postLines(item.post.text, textWidth);
  let mediaRow = 2 + List.length(lines);
  let metricsRow = cardHeight(area.width, size, scale, item) - 2;
  let rows = imageRows(
    textWidth,
    Geometry.nonNegative(maximumCardHeight(size) - baseCardHeight(area.width, size, item)),
    size,
    scale,
    item,
  );
  let mediaArea = Geometry.intersect(Geometry.rect(textX, area.y + mediaRow, textWidth, rows), contentBody(size));
  let image = if (showImages) {
    Ui.optional(mediaValue(item.image), (value) => {
      Ui.imageViewport(imageId, Geometry.rect(textX, area.y + mediaRow, textWidth, rows), contentBody(size), scale, value)
    })
  } else {
    Ui.empty
  };
  if (rows <= 0) {
    ""
  } else {
    ImageHost.deleteImage(imageId) ++ Draw.fill(mediaArea, " ", Draw.plain) ++
      Ui.render(size, image)
  }
};

let rec mediaCards = match(area, posts, index, layout, showImages) => {
  (_, [], _, _, _) => { "" },
  (_, _, _, _, _) => {
    match(posts) {
      [] => { "" },
      [item, ..tail] => {
        let height = cardHeight(area.width, layout.size, layout.scale, item);
        if (area.height < 2) {
          ""
        } else {
          let visibleHeight = Geometry.clamp(2, height, area.height);
          let cardArea = Geometry.rect(area.x, area.y, area.width, visibleHeight);
          cardMedia(cardArea, item, layout.size, layout.scale, 99000 + index, showImages) ++
            mediaCards(
              Geometry.rect(
                area.x,
                area.y + visibleHeight - 1,
                area.width,
                area.height - visibleHeight + 1,
              ),
              tail,
              index + 1,
              layout,
              showImages,
            )
        }
      },
    }
  },
};

let renderMediaCards = (area, posts, start, layout, showImages) => {
  mediaCards(area, posts, start, layout, showImages)
};

let rec cards = match(area, posts, index, layout, showImages) => {
  (_, [], _, _, _) => { Ui.empty },
  (_, _, _, _, _) => {
    match(posts) {
      [] => { Ui.empty },
      [item, ..tail] => {
        let height = cardHeight(area.width, layout.size, layout.scale, item);
        if (area.height < 2) {
          Ui.fill(area, "─", Draw.muted)
        } else {
          let visibleHeight = Geometry.clamp(2, height, area.height);
          let joinedBottom = match(tail) {
            [] => { false },
            _ => { area.height > visibleHeight },
          };
          Ui.fragment([
            card(
              Geometry.rect(area.x, area.y, area.width, visibleHeight),
              item,
              layout.size,
              layout.scale,
              joinedBottom,
              1000 + index,
              showImages,
            ),
            cards(
              Geometry.rect(
                area.x,
                area.y + visibleHeight - 1,
                area.width,
                area.height - visibleHeight + 1,
              ),
              tail,
              index + 1,
              layout,
              showImages,
            ),
          ])
        }
      },
    }
  },
};

let renderCards = (area, posts, index, layout: FeedLayout) => {
  Ui.render(layout.size, cards(area, posts, index, layout, true))
};

let renderCardsVisible = (area, posts, index, layout: FeedLayout, showImages) => {
  Ui.render(layout.size, cards(area, posts, index, layout, showImages))
};

let rec metricCards = match(area, posts, layout) => {
  (_, [], _) => { Ui.empty },
  (_, [item, ..tail], _) => {
    if (area.height < 2) { Ui.empty } else {
      let height = Geometry.clamp(2, cardHeight(area.width, layout.size, layout.scale, item), area.height);
      Ui.fragment([
        cardMetrics(Geometry.rect(area.x, area.y, area.width, height), item, layout.size, layout.scale),
        metricCards(Geometry.rect(area.x, area.y + height - 1, area.width, area.height - height + 1), tail, layout),
      ])
    }
  },
};
let renderMetrics = (area, posts, layout: FeedLayout) => { Ui.render(layout.size, metricCards(area, posts, layout)) };
