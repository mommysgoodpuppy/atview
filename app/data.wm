-- Converts protocol data into image-aware application models.

from "./model.wm" import *;
from "../proto/api.wm" import { AppFeeds, FeedPost };
from "../proto/views.wm" import * as Views;
from "../proto/xrpc.wm" import { describeError };
from "../tui/geometry.wm" import * as Geometry;
from "../tui/kitty.wm" import * as Kitty;
from "../tui/resource.wm" import * as Resource;

let rec loadPosts = match(posts, remaining) => {
  ([], _) => { Task.succeed([]) },
  ([post, ..tail], _) => {
    let feedPost: FeedPost = post;
    let imageTask = if (remaining <= 0) {
      Task.succeed(None)
    } else {
      match(feedPost.image) {
        None => { Task.succeed(None) },
        Some(source) => {
          let typedSource: Views.PostImage = source;
          Kitty.loadEncoded(typedSource)
            :> Task.map(Some)
            :> Task.recover((_) => { None })
        },
      }
    };
    let nextRemaining = match(feedPost.image) {
      Some(_) => {
        if (remaining <= 0) { 0 } else { remaining - 1 }
      },
      None => { remaining },
    };
    let avatarTask = match(feedPost.avatar) {
      None => { Task.succeed(None) },
      Some(url) => {
        Kitty.loadEncodedAvatar(url)
          :> Task.map(Some)
          :> Task.recover((_) => { None })
      },
    };
    Task|
      imageTask,
      avatarTask,
      loadPosts(tail, nextRemaining)
    | :> Task.map((image, avatar, loadedTail) => {
      [UiPost(feedPost, Resource.Ready(image), Resource.Ready(avatar)), ..loadedTail]
    })
  },
};

let loadUiFeeds = (feeds: AppFeeds) => {
  Task|
    loadPosts(feeds.timelinePosts, 3),
    loadPosts(feeds.ownPosts, 3)
  | :> Task.map((timelinePosts, ownPosts) => {
    makeUiFeeds(
      feeds.handle,
      feeds.did,
      feeds.accessJwt,
      timelinePosts,
      ownPosts,
      feeds.timelineCursor,
      feeds.ownCursor,
    )
  })
};

-- First paint must not wait on media. Posts start with no image or avatar and
-- are filled in by background tasks, each of which resolves to a state update
-- keyed by post uri, the same shape the thread prefetch already uses.
let rec pendingPosts = match(posts) => {
  [] => { [] },
  [post, ..tail] => {
    let feedPost: FeedPost = post;
    let image = match(feedPost.image) {
      None => { Resource.Ready(None) },
      Some(_) => { Resource.Pending },
    };
    let avatar = match(feedPost.avatar) {
      None => { Resource.Ready(None) },
      Some(_) => { Resource.Pending },
    };
    [UiPost(feedPost, image, avatar), ..pendingPosts(tail)]
  },
};

let uiFeedsPending = (feeds: AppFeeds) => {
  makeUiFeeds(
    feeds.handle,
    feeds.did,
    feeds.accessJwt,
    pendingPosts(feeds.timelinePosts),
    pendingPosts(feeds.ownPosts),
    feeds.timelineCursor,
    feeds.ownCursor,
  )
};

-- An unrelated task may carry an old pending/loading snapshot. Only publish
-- completed resources, and keep media that has already loaded successfully.
let mergeMedia = (current, incoming) => {
  match(current, incoming) {
    (Resource.Ready(Some(_)), _) => { current },
    (_, Resource.Pending) => { current },
    (_, Resource.Loading) => { current },
    (_, _) => { incoming },
  }
};

let rec republishPost = match(posts, uri, image, avatar) => {
  ([], _, _, _) => { [] },
  ([post, ..tail], _, _, _) => {
    let current: UiPost = post;
    if (current.post.uri == uri) {
      let nextImage = mergeMedia(current.image, image);
      let nextAvatar = mergeMedia(current.avatar, avatar);
      [UiPost(current.post, nextImage, nextAvatar), ..republishPost(tail, uri, image, avatar)]
    } else {
      [current, ..republishPost(tail, uri, image, avatar)]
    }
  },
};

let publishPostMedia = (state: UiState, uri, image, avatar) => {
  let feeds: UiFeeds = state.feeds;
  UiState(
    state.selected,
    state.view,
    state.imageScale,
    .{ ..feeds, preloadVersion = feeds.preloadVersion + 1, tabs = feeds.tabs :> List.map((tab) => {
      .{ ..tab, posts = republishPost(tab.posts, uri, image, avatar) }
    }) },
    state.loading,
    state.status,
    state.renderVersion + (if (List.find(postsFor(state.feeds, state.view), (post) => { post.post.uri == uri }) != None) { 1 } else { 0 }),
    state.thread,
    state.threadGraph,
    state.scrolling,
    state.scrollVersion,
    state.scrollFrame,
    state.scrollRows,
  )
};

let postMediaTask = (post: UiPost, wantImage) => {
  let feedPost: FeedPost = post.post;
  let imageTask = if (wantImage && Resource.isPending(post.image)) {
    match(feedPost.image) {
      None => { Task.succeed(Resource.Ready(None)) },
      Some(source) => {
        let typedSource: Views.PostImage = source;
        Kitty.loadEncoded(typedSource)
          :> Task.map((image) => { Resource.Ready(Some(image)) })
          :> Task.recover((error) => { Resource.Failed(describeError(error)) })
      },
    }
  } else {
    Task.succeed(post.image)
  };
  let avatarTask = if (!Resource.isPending(post.avatar)) {
    Task.succeed(post.avatar)
  } else {
    match(feedPost.avatar) {
      None => { Task.succeed(Resource.Ready(None)) },
      Some(url) => {
        Kitty.loadEncodedAvatar(url)
          :> Task.map((avatar) => { Resource.Ready(Some(avatar)) })
          :> Task.recover((error) => { Resource.Failed(describeError(error)) })
      },
    }
  };
  Task|
    imageTask,
    avatarTask
  | :> Task.map((image, avatar) => {
    (current: UiState) => { publishPostMedia(current, feedPost.uri, image, avatar) }
  })
};

let loading = match(resource) => {
  Resource.Pending => { Resource.Loading },
  _ => { resource },
};

let rec markPostMedia = match(posts, uri, wantImage) => {
  ([], _, _) => { [] },
  ([post, ..tail], _, _) => {
    let current: UiPost = post;
    if (current.post.uri == uri) {
      [
        UiPost(
          current.post,
          if (wantImage) { loading(current.image) } else { current.image },
          loading(current.avatar),
        ),
        ..markPostMedia(tail, uri, wantImage)
      ]
    } else {
      [current, ..markPostMedia(tail, uri, wantImage)]
    }
  },
};

-- Share resources when a later page/tab introduces an already known post.
let sharedResource = match(current, known) => {
  (Resource.Pending, _) => { known },
  _ => { current },
};
let sharedPost = (state: UiState, post: UiPost) => {
  List.foldLeft(state.feeds.tabs, post, (current, tab) => {
    List.foldLeft(tab.posts, current, (value, known) => {
      if (known.post.uri != post.post.uri) { value } else {
        .{ ..value, image = sharedResource(value.image, known.image), avatar = sharedResource(value.avatar, known.avatar) }
      }
    })
  })
};
let markMediaLoading = (state: UiState, uri, wantImage) => {
  .{ ..state, feeds = .{ ..state.feeds, preloadVersion = state.feeds.preloadVersion + 1, tabs = state.feeds.tabs :> List.map((tab) => {
    .{ ..tab, posts = markPostMedia(tab.posts, uri, wantImage) }
  }) } }
};
record MediaRequest = { view: FeedView, uri: String, wantImage: Bool };
let loadingPosts = (state: UiState) => {
  List.foldLeft(state.feeds.tabs, []: List<String>, (uris, tab) => {
    List.foldLeft(tab.posts, uris, (known, post) => {
      let loading = match(post.image, post.avatar) {
        (Resource.Loading, _) => { true },
        (_, Resource.Loading) => { true },
        _ => { false },
      };
      if (loading && List.find(known, (uri) => { uri == post.post.uri }) == None) { [post.post.uri, ..known] } else { known }
    })
  })
};
-- Bound concurrent posts, and re-read after each request to deduplicate shared
-- URIs across surfaces. Visible requests come first in the caller's ranking.
let planMediaRequestsWith = (state: UiState, requests, maximum, loadMedia) => {
  let rec plan = match(remaining, current, slots) => {
    ([], _, _) => { current },
    (_, _, 0) => { current },
    ([request, ..tail], _, _) => {
      let post = List.find(postsFor(current.state.feeds, request.view), (item) => { item.post.uri == request.uri });
      match(post) {
        None => { plan(tail, current, slots) },
        Some(item) => {
          let wantImage = request.wantImage && Resource.isPending(item.image);
          let wantAvatar = Resource.isPending(item.avatar);
          if (!wantImage && !wantAvatar) { plan(tail, current, slots) } else {
            let next = markMediaLoading(current.state, request.uri, wantImage);
            plan(tail, MediaPlan(next, List.append(current.tasks, [loadMedia(item, wantImage)])), slots - 1)
          }
        },
      }
    },
  };
  plan(requests, MediaPlan(state, []), Geometry.nonNegative(maximum - List.length(loadingPosts(state))))
};

let planMediaRequests = (state, requests, maximum) => {
  planMediaRequestsWith(state, requests, maximum, postMediaTask)
};

let withThread = (state: UiState, thread, version) => {
  UiState(
    state.selected,
    state.view,
    state.imageScale,
    state.feeds,
    state.loading,
    state.status,
    version,
    thread,
    state.threadGraph,
    state.scrolling,
    state.scrollVersion,
    state.scrollFrame,
    state.scrollRows,
  )
};

let rec boundThreadNodes = match(nodes, remaining) => {
  ([], _) => { BoundedThreadNodes([], remaining) },
  (_, _) => {
    if (remaining <= 0) {
      BoundedThreadNodes([], 0)
    } else {
      match(nodes) {
        [] => { BoundedThreadNodes([], remaining) },
        [node, ..tail] => {
          match(node) {
            Views.ThreadPost(post, replies) => {
              let boundedReplies = boundThreadNodes(replies, remaining - 1);
              let boundedTail = boundThreadNodes(
                tail,
                boundedReplies.remaining,
              );
              BoundedThreadNodes(
                [
                  Views.ThreadPost(post, boundedReplies.nodes),
                  ..boundedTail.nodes
                ],
                boundedTail.remaining,
              )
            },
            Views.MissingPost(uri) => {
              let boundedTail = boundThreadNodes(tail, remaining - 1);
              BoundedThreadNodes(
                [Views.MissingPost(uri), ..boundedTail.nodes],
                boundedTail.remaining,
              )
            },
            Views.BlockedPost(uri) => {
              let boundedTail = boundThreadNodes(tail, remaining - 1);
              BoundedThreadNodes(
                [Views.BlockedPost(uri), ..boundedTail.nodes],
                boundedTail.remaining,
              )
            },
            Views.UnknownThread(typeName) => {
              let boundedTail = boundThreadNodes(tail, remaining - 1);
              BoundedThreadNodes(
                [Views.UnknownThread(typeName), ..boundedTail.nodes],
                boundedTail.remaining,
              )
            },
          }
        },
      }
    }
  },
};

let rec loadUiThreadNodes = match(nodes) => {
  [] => { Task.succeed([]) },
  [node, ..tail] => {
    match(node) {
      Views.ThreadPost(post, replies) => {
        let avatarTask = match(post.author.avatar) {
          None => { Task.succeed(None) },
          Some(url) => {
            Kitty.loadEncodedAvatar(url)
              :> Task.map(Some)
              :> Task.recover((_) => { None })
          },
        };
        Task|
          avatarTask,
          loadUiThreadNodes(replies),
          loadUiThreadNodes(tail)
        | :> Task.map((avatar, loadedReplies, loadedTail) => {
          [
            UiThreadPost(post, avatar, loadedReplies),
            ..loadedTail
          ]
        })
      },
      Views.MissingPost(uri) => {
        loadUiThreadNodes(tail) :> Task.map((loadedTail) => {
          [UiMissingPost(uri), ..loadedTail]
        })
      },
      Views.BlockedPost(uri) => {
        loadUiThreadNodes(tail) :> Task.map((loadedTail) => {
          [UiBlockedPost(uri), ..loadedTail]
        })
      },
      Views.UnknownThread(typeName) => {
        loadUiThreadNodes(tail) :> Task.map((loadedTail) => {
          [UiUnknownThread(typeName), ..loadedTail]
        })
      },
    }
  },
};

let loadUiThread = (thread: Views.Thread) => {
  let bounded = boundThreadNodes([thread], 13);
  loadUiThreadNodes(bounded.nodes) :> Task.map((nodes) => {
    match(nodes) {
      [node, .._] => { node },
      [] => { UiUnknownThread("(empty thread)") },
    }
  })
};
